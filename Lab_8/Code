#include <GL/glut.h>
#include <cmath>
int isDay = 1; // Initial state: 1 for Day, 0 for Night
// Function to draw a filled circle
void drawCircle(float x, float y, float radius) {
glBegin(GL_POLYGON);
for (int i = 0; i < 360; i++) {
float angle = i * 3.14159f / 180.0f;
glVertex2f(x + (cos(angle) * radius), y + (sin(angle) * radius));
}
glEnd();
}
void display() {
// 1. Background Color Logic
if(isDay)
glClearColor(1.0f, 1.0f, 1.0f, 1.0f); // white for Day
else
glClearColor(0.05f, 0.05f, 0.1f, 1.0f); // Dark Night Sky
glClear(GL_COLOR_BUFFER_BIT);
// ==========================================
// 2. Road
// ==========================================
glBegin(GL_QUADS);
glColor3f(0.0f, 0.0f, 0.0f);
glVertex2f(-1.0f, -0.4f);
glVertex2f(1.0f, -0.4f);
glVertex2f(1.0f, -0.8f);
glVertex2f(-1.0f, -0.8f);
glEnd();
// ==========================================
// 3. White Dash Lines
// ==========================================
glColor3f(1.0f, 1.0f, 1.0f);
// Dash 1
glBegin(GL_QUADS); glVertex2f(-0.8f, -0.6f); glVertex2f(-0.6f, -0.6f); glVertex2f(-0.6f, -0.62f);
glVertex2f(-0.8f, -0.62f); glEnd();

// Dash 2
glBegin(GL_QUADS); glVertex2f(-0.3f, -0.6f); glVertex2f(-0.1f, -0.6f); glVertex2f(-0.1f, -0.62f);
glVertex2f(-0.3f, -0.62f); glEnd();
// Dash 3
glBegin(GL_QUADS); glVertex2f(0.2f, -0.6f); glVertex2f(0.4f, -0.6f); glVertex2f(0.4f, -0.62f);
glVertex2f(0.2f, -0.62f); glEnd();
// Dash 4
glBegin(GL_QUADS); glVertex2f(0.7f, -0.6f); glVertex2f(0.9f, -0.6f); glVertex2f(0.9f, -0.62f);
glVertex2f(0.7f, -0.62f); glEnd();
// ==========================================
// 4. Light Stands and Bulbs
// ==========================================
float standPositions[] = {-0.62f, 0.0f, 0.60f};
for(int i = 0; i < 3; i++) {
float x = standPositions[i];
// Pole
glColor3f(0.1f, 0.3f, 0.6f);
glBegin(GL_QUADS);
glVertex2f(x - 0.02f, 0.4f); glVertex2f(x + 0.02f, 0.4f);
glVertex2f(x + 0.02f, -0.4f); glVertex2f(x - 0.02f, -0.4f);
glEnd();
// Bulb Color Logic
if(isDay)
glColor3f(0.8f, 0.8f, 0.8f); // Light Gray bulb when OFF
else
glColor3f(1.0f, 1.0f, 0.0f); // Bright Yellow bulb when ON
drawCircle(x, 0.50f, 0.10f);
// Filament Color Logic
if(isDay)
glColor3f(0.3f, 0.3f, 0.3f); // Dark Gray filament when OFF
else
glColor3f(1.0f, 0.4f, 0.0f); // Glowing Orange filament when ON
glBegin(GL_LINE_STRIP);
glVertex2f(x - 0.04f, 0.48f); glVertex2f(x - 0.02f, 0.53f);
glVertex2f(x, 0.48f); glVertex2f(x + 0.02f, 0.53f);
glVertex2f(x + 0.04f, 0.48f);
glEnd();

}
glFlush();
}
void keyboard(unsigned char key, int x, int y) {
if(key == 'd' || key == 'D') isDay = 1;
else if(key == 'n' || key == 'N') isDay = 0;
glutPostRedisplay();
}
int main(int argc, char** argv) {
glutInit(&argc, argv);
glutInitWindowSize(600, 600);
glutCreateWindow("Street Lights Day/Night");
glutDisplayFunc(display);
glutKeyboardFunc(keyboard);
glutMainLoop();
return 0;
}
