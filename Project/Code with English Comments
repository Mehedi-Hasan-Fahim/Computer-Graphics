/*
 * drawFilledCircle() - Draws a filled circle
 * Parameters (Parameters):
 *   cx, cy : X and Y coordinates of the circle's center
 *   r      : Radius of the circle
 *
 * Task: Creates a filled circle using 360 points with GL_POLYGON
 * cos(angle) = distance in X direction, sin(angle) = distance in Y direction
 */
void drawFilledCircle(float cx, float cy, float r) {
    glBegin(GL_POLYGON); // Start drawing filled polygon
    for (int i = 0; i < 360; i++) {
        // Determine points by converting each degree to radians
        float angle = i * PI / 180.0f;
        glVertex2f(cx + cos(angle) * r, cy + sin(angle) * r);
    }
    glEnd(); // Drawing finished
}

/*
 * drawCircleOutline() - Draws an empty circle (border only)
 * Parameters: Same as drawFilledCircle()
 *
 * GL_LINE_LOOP: Closes the line by returning from the last point to the first
 */
void drawCircleOutline(float cx, float cy, float r) {
    glBegin(GL_LINE_LOOP); // Start drawing closed line loop
    for (int i = 0; i < 360; i++) {
        float angle = i * PI / 180.0f;
        glVertex2f(cx + cos(angle) * r, cy + sin(angle) * r);
    }
    glEnd();
}

/*
 * drawArch() - Draws a semi-circular arch
 * Parameters:
 *   cx, cy         : Center point
 *   radiusX        : Horizontal radius (width)
 *   radiusY        : Vertical radius (height)
 *
 * Task: Draws from 0° to 180° (top half)
 * Used to draw the hanging hook above the gondola roof
 */
void drawArch(float cx, float cy, float radiusX, float radiusY) {
    glBegin(GL_LINE_STRIP); // Start drawing connected lines
    for (int i = 0; i <= 180; i++) {
        float angle = i * PI / 180.0f;
        // Ellipse formula: x = cx + radiusX*cos(angle), y = cy + radiusY*sin(angle)
        glVertex2f(cx + cos(angle) * radiusX, cy + sin(angle) * radiusY);
    }
    glEnd();

    // A small vertical line above the arch (like a hanging hook)
    glBegin(GL_LINES);
    glVertex2f(cx, cy + radiusY);          // Bottom point of the hook
    glVertex2f(cx, cy + radiusY + 0.02f);  // Top point of the hook
    glEnd();
}


