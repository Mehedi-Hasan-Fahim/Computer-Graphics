/*
 * drawSunOrMoon() - দিনে সূর্য, রাতে চাঁদ আঁকে
 *
 * সূর্য: হলুদ বৃত্ত + চারপাশে রশ্মি (glLineWidth দিয়ে মোটা রেখা)
 *        রশ্মি আঁকা হয় 0° থেকে 330° পর্যন্ত 30° পরপর
 *
 * চাঁদ: সাদা বৃত্ত + উপরে ছোট ছোট বৃত্ত (crater/গর্ত দেখানোর জন্য)
 */
void drawSunOrMoon() {
    float sx = -0.8f, sy = 0.88f; // সূর্য/চাঁদের অবস্থান (উপর-বাম কোণে)

    if (isDayMode) {
        // ========== সূর্য আঁকা ==========
        glColor3f(1.0f, 0.85f, 0.3f); // সোনালি হলুদ রঙ
        glLineWidth(2.0f); // মোটা রেখা

        // সূর্যের রশ্মি আঁকা (12টি রশ্মি, 30° পরপর)
        for (int i = 0; i < 360; i += 30) {
            float angle = i * PI / 180.0f;
            glBegin(GL_LINES);
            // রশ্মির ভেতরের বিন্দু (বৃত্তের উপর)
            glVertex2f(sx + cos(angle) * 0.07f, sy + sin(angle) * 0.07f);
            // রশ্মির বাইরের বিন্দু (বৃত্তের বাইরে)
            glVertex2f(sx + cos(angle) * 0.11f, sy + sin(angle) * 0.11f);
            glEnd();
        }
        glLineWidth(1.0f); // আবার স্বাভাবিক রেখার মোটা

        // সূর্যের কেন্দ্রে হলুদ ভরা বৃত্ত
        glColor3f(1.0f, 0.92f, 0.2f);
        drawFilledCircle(sx, sy, 0.065f);
        // সূর্যের গাঢ় হলুদ বর্ডার
        glColor3f(1.0f, 0.7f, 0.0f);
        drawCircleOutline(sx, sy, 0.065f);
    } else {
        // ========== চাঁদ আঁকা ==========
        // সাদা-ধূসর রঙের ভরা বৃত্ত (পূর্ণ চাঁদ)
        glColor3f(0.9f, 0.9f, 0.95f);
        drawFilledCircle(sx, sy, 0.065f);

        // চাঁদের গর্ত (crater) আঁকা - ৩টি ছোট ধূসর বৃত্ত
        glColor3f(0.75f, 0.75f, 0.8f);
        drawFilledCircle(sx - 0.015f, sy + 0.015f, 0.015f); // বড় গর্ত
        drawFilledCircle(sx + 0.020f, sy - 0.020f, 0.010f); // মাঝারি গর্ত
        drawFilledCircle(sx + 0.015f, sy + 0.025f, 0.008f); // ছোট গর্ত
    }
}


