/*
 * drawFilledCircle() - একটি ভরা বৃত্ত আঁকে
 * Parameters (প্যারামিটার):
 *   cx, cy : বৃত্তের কেন্দ্র বিন্দুর X ও Y অবস্থান
 *   r      : বৃত্তের ব্যাসার্ধ (radius)
 *
 * কাজ: GL_POLYGON ব্যবহার করে 360টি বিন্দু দিয়ে একটি ভরা বৃত্ত তৈরি করে
 * cos(angle) = X দিকের দূরত্ব, sin(angle) = Y দিকের দূরত্ব
 */
void drawFilledCircle(float cx, float cy, float r) {
    glBegin(GL_POLYGON); // ভরা বহুভুজ আঁকা শুরু
    for (int i = 0; i < 360; i++) {
        // প্রতিটি ডিগ্রিকে রেডিয়ানে রূপান্তর করে বিন্দু নির্ধারণ
        float angle = i * PI / 180.0f;
        glVertex2f(cx + cos(angle) * r, cy + sin(angle) * r);
    }
    glEnd(); // আঁকা শেষ
}

/*
 * drawCircleOutline() - একটি ফাঁকা বৃত্ত (শুধু বর্ডার) আঁকে
 * Parameters: drawFilledCircle() এর মতোই
 *
 * GL_LINE_LOOP: শেষ বিন্দু থেকে প্রথম বিন্দুতে ফিরে এসে রেখা বন্ধ করে
 */
void drawCircleOutline(float cx, float cy, float r) {
    glBegin(GL_LINE_LOOP); // বদ্ধ রেখাচক্র আঁকা শুরু
    for (int i = 0; i < 360; i++) {
        float angle = i * PI / 180.0f;
        glVertex2f(cx + cos(angle) * r, cy + sin(angle) * r);
    }
    glEnd();
}

/*
 * drawArch() - একটি অর্ধবৃত্তাকার খিলান (arch) আঁকে
 * Parameters:
 *   cx, cy         : কেন্দ্র বিন্দু
 *   radiusX        : অনুভূমিক ব্যাসার্ধ (চওড়া)
 *   radiusY        : উল্লম্ব ব্যাসার্ধ (উচ্চতা)
 *
 * কাজ: 0° থেকে 180° পর্যন্ত আঁকে (উপরের অর্ধেক)
 * গন্ডোলার ছাদের উপরে ঝুলানো হুক আঁকতে ব্যবহার হয়
 */
void drawArch(float cx, float cy, float radiusX, float radiusY) {
    glBegin(GL_LINE_STRIP); // সংযুক্ত রেখা আঁকা শুরু
    for (int i = 0; i <= 180; i++) {
        float angle = i * PI / 180.0f;
        // উপবৃত্তের সূত্র: x = cx + radiusX*cos(angle), y = cy + radiusY*sin(angle)
        glVertex2f(cx + cos(angle) * radiusX, cy + sin(angle) * radiusY);
    }
    glEnd();

    // খিলানের উপরে একটি ছোট উল্লম্ব রেখা (ঝুলানো হুকের মতো)
    glBegin(GL_LINES);
    glVertex2f(cx, cy + radiusY);          // হুকের নিচের বিন্দু
    glVertex2f(cx, cy + radiusY + 0.02f);  // হুকের উপরের বিন্দু
    glEnd();
}


