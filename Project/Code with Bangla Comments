//                    MAIN FUNCTION (প্রধান ফাংশন)
// ============================================================

/*
 * main() - প্রোগ্রামের শুরু
 *
 * ধাপসমূহ:
 *   ১. glutInit()           → GLUT শুরু করো
 *   ২. glutInitDisplayMode() → Double buffer (মসৃণ অ্যানিমেশন) + RGB রঙ মোড
 *   ③. glutInitWindowSize()  → 1000x700 পিক্সেলের উইন্ডো
 *   ৪. glutCreateWindow()    → উইন্ডো তৈরি করো
 *   ৫. glEnable(GL_BLEND)   → Transparency সক্রিয় করো
 *   ৬. Callback functions নিবন্ধন করো
 *   ৭. glutMainLoop()        → GLUT ইভেন্ট লুপ শুরু (অসীম লুপ)
 *
 * Double Buffering কেন?
 *   Single buffer হলে আঁকার সময় স্ক্রিনে ঝাঁকুনি দেখা যায়।
 *   Double buffer = একটি buffer এ আঁকো, অন্যটি দেখাও, তারপর বদলাও।
 *   glutSwapBuffers() দিয়ে দুটো buffer বদলানো হয়।
 */
int main(int argc, char** argv) {
    glutInit(&argc, argv);                              // GLUT প্রাথমিক সেটআপ
    glutInitDisplayMode(GLUT_DOUBLE | GLUT_RGB);        // Double buffer + RGB মোড
    glutInitWindowSize(900, 600);                      // উইন্ডো আকার: 1000×700
    glutCreateWindow("Interactive Village Fair - Graphics Project"); // উইন্ডো তৈরি

    // Transparency (স্বচ্ছতা) সক্রিয় করা
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA); // আলফা মিশ্রণ পদ্ধতি

    // ===== Callback Functions নিবন্ধন =====
    glutDisplayFunc(display);      // স্ক্রিন আঁকার ফাংশন
    glutKeyboardFunc(keyboard);    // সাধারণ কী চাপার ফাংশন
    glutSpecialFunc(specialKeys);  // বিশেষ কী (Arrow) চাপার ফাংশন
    glutTimerFunc(0, timer, 0);    // অ্যানিমেশন টাইমার (0ms পরে প্রথম কল)

    glutMainLoop(); // GLUT ইভেন্ট লুপ শুরু (প্রোগ্রাম এখানে আটকে থাকে)
    return 0;       // প্রোগ্রাম শেষ (এই লাইনে কখনো পৌঁছায় না)
}
