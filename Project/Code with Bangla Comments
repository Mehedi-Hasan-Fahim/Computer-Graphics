//           INPUT & ANIMATION CALLBACKS
//           ইনপুট ও অ্যানিমেশন কলব্যাক ফাংশন
// ============================================================

/*
 * keyboard() - সাধারণ কীবোর্ড ইনপুট পরিচালনা করে
 * Parameters:
 *   key  : চাপা হওয়া অক্ষরের ASCII কোড
 *   x, y : মাউসের অবস্থান (এখানে ব্যবহার হয়নি)
 *
 * D/d → দিনের মোড
 * N/n → রাতের মোড (নোটিফিকেশন না থাকলে)
 * Y/y → দোকান থেকে কিনুন
 * R/r → দোকান থেকে কিনবেন না
 *

 * তাই showNotification চেক করে কোন কাজ করবে ঠিক করা হয়
 */
void keyboard(unsigned char key, int x, int y) {
    if (key == 'D' || key == 'd') {
        isDayMode = true;  // দিনের মোড চালু
    } else if (key == 'N' || key == 'n') {
        isDayMode = false; // রাতের মোড চালু
    } else if (showNotification) {
        // নোটিফিকেশন দেখা অবস্থায় Y বা N চাপলে
        if (key == 'y' || key == 'Y') {
            // হ্যাঁ - জিনিস কিনুন
            if (currentShop == 1) {
                hasLeftItem = true;   // ফল কিনলাম
                askedLeft = true;     // আর জিজ্ঞেস করবো না
            } else if (currentShop == 2) {
                hasRightItem = true;  // বেলুন কিনলাম
                askedRight = true;    // আর জিজ্ঞেস করবো না
            }
            showNotification = false; // নোটিফিকেশন বন্ধ
        } else if (key == 'r' || key == 'R') {
            // না - জিনিস কিনবো না
            if (currentShop == 1) askedLeft = true;   // আর জিজ্ঞেস করবো না
            else if (currentShop == 2) askedRight = true;
            showNotification = false; // নোটিফিকেশন বন্ধ
        }
    }
    glutPostRedisplay(); // স্ক্রিন পুনরায় আঁকার অনুরোধ
}

/*
 * specialKeys() - বিশেষ কী (Arrow Keys) পরিচালনা করে
 *
 * Arrow Keys দিয়ে চরিত্র নাড়ানো হয়।
 * চরিত্রের চলাচলের সীমা নির্ধারণ করা আছে:
 *   X সীমা: -0.90 থেকে 0.90 (স্ক্রিনের মধ্যে)
 *   Y সীমা: -0.47 থেকে -0.07 (মাটির স্তরে)
 */
void specialKeys(int key, int x, int y) {
    if (key == GLUT_KEY_LEFT)  userX -= USER_SPEED; // বামে যাও
    if (key == GLUT_KEY_RIGHT) userX += USER_SPEED; // ডানে যাও
    if (key == GLUT_KEY_UP)    userY += USER_SPEED; // উপরে যাও
    if (key == GLUT_KEY_DOWN)  userY -= USER_SPEED; // নিচে যাও

    // X অক্ষের সীমা (স্ক্রিনের বাইরে যাবে না)
    if (userX < -0.90f) userX = -0.90f;
    if (userX >  0.90f) userX =  0.90f;

    // Y অক্ষের সীমা (মাটির স্তরে থাকবে)
    if (userY < -0.47f) userY = -0.47f; // নিচের সীমা
    if (userY > -0.07f) userY = -0.07f; // উপরের সীমা

    glutPostRedisplay(); // স্ক্রিন পুনরায় আঁকার অনুরোধ
}

/*
 * timer() - নির্দিষ্ট সময় পরপর অ্যানিমেশন আপডেট করে
 *
 * TIMER_MS (20ms) = প্রতি সেকেন্ডে 50 ফ্রেম (50 FPS)
 *
 * প্রতি কলে:
 *   ১. wheelAngle কমানো → চাকা ঘড়ির বিপরীতে ঘোরে
 *   ২. cloudOffset বাড়ানো → মেঘ ডান দিকে সরে
 *   ৩. glutPostRedisplay() → পরের ফ্রেম আঁকার অনুরোধ
 *   ৪. glutTimerFunc() → পরের কল নির্ধারণ (পুনরাবৃত্তি)
 */
void timer(int) {
    wheelAngle -= WHEEL_SPEED; // চাকা ঘড়ির বিপরীতে ঘোরে (negative = anti-clockwise)
    if (wheelAngle < -360.0f) wheelAngle += 360.0f; // -360 এর কম হলে রিসেট

    cloudOffset += CLOUD_SPEED; // মেঘ ধীরে ধীরে ডানে সরে

    glutPostRedisplay();              // স্ক্রিন পুনরায় আঁকার অনুরোধ
    glutTimerFunc(TIMER_MS, timer, 0); // TIMER_MS পরে আবার কল করো
}


