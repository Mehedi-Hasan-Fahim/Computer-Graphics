#include <GL/glut.h>
#include <cmath>
// Circle parameters
float xc = -0.32f, yc = 0.3f; // center of the circle
float r = 0.15f; // radius of the circle
void display() {
glClearColor(1.0f, 1.0f, 1.0f, 1.0f);
glClear(GL_COLOR_BUFFER_BIT);

glBegin(GL_QUADS);
glColor3f(1.0f, 1.0f, 1.0f);
glVertex2f(-0.6f, 0.6f);
glVertex2f(0.4f, 0.6f);
glVertex2f(0.4f, 0.3f);
glVertex2f(-0.6f, 0.3f);
glEnd();
glBegin(GL_LINE_LOOP);
glColor3f(0.0f, 0.0f, 0.0f);
glVertex2f(-0.6f, 0.6f);
glVertex2f(0.4f, 0.6f);
glVertex2f(0.4f, 0.3f);
glVertex2f(-0.6f, 0.3f);
glEnd();
glBegin(GL_QUADS);
glColor3f(1.0f, 0.0f, 0.0f);
glVertex2f(-0.6f, 0.3f);
glVertex2f(0.4f, 0.3f);
glVertex2f(0.4f, 0.0f);
glVertex2f(-0.6f, 0.0f);
glEnd();
glBegin(GL_LINE_LOOP);
glColor3f(0.0f, 0.0f, 0.0f);
glVertex2f(-0.6f, 0.3f);
glVertex2f(0.4f, 0.3f);
glVertex2f(0.4f, 0.0f);
glVertex2f(-0.6f, 0.0f);
glEnd();
glBegin(GL_QUADS);
glColor3f(0.48f, 0.25f, 0.0f);

glVertex2f(-0.6025f, 0.721f);
glVertex2f(-0.6f, -0.6f);
glVertex2f(-0.687f, -0.599f);
glVertex2f(-0.683f, 0.721f);
glEnd();
glBegin(GL_LINE_LOOP);
glColor3f(0.0f, 0.0f, 0.0f);
glVertex2f(-0.6025f, 0.721f);
glVertex2f(-0.6f, -0.6f);
glVertex2f(-0.687f, -0.599f);
glVertex2f(-0.683f, 0.721f);
glEnd();
glBegin(GL_POLYGON);
glColor3f(1.0f, 1.0f, 1.0f);
for (int theta = 0; theta < 360; theta += 1) {
float rad = theta * 3.14159f / 180.0f;
float x = xc + r * cos(rad);
float y = yc + r * sin(rad);
glVertex2f(x, y);
}
glEnd();
glBegin(GL_LINE_LOOP);
glColor3f(0.0f, 0.0f, 0.0f);
for (int theta = 0; theta < 360; theta += 1) {
float rad = theta * 3.14159f / 180.0f;
float x = xc + r * cos(rad);
float y = yc + r * sin(rad);
glVertex2f(x, y);
}
glEnd();
glBegin(GL_POLYGON);

glColor3f(1.0f, 0.0f, 0.0f);
for (int theta = 0; theta <= 180; theta += 1) {
float rad = theta * 3.14159f / 180.0f;
float x = xc + r * cos(rad);
float y = yc + r * sin(rad);
glVertex2f(x, y);
}
glEnd();
glBegin(GL_LINE_LOOP);
glColor3f(0.0f, 0.0f, 0.0f);
for (int theta = 0; theta <= 180; theta += 1) {
float rad = theta * 3.14159f / 180.0f;
float x = xc + r * cos(rad);
float y = yc + r * sin(rad);
glVertex2f(x, y);
}
glEnd();
glFlush();
}
int main(int argc, char** argv) {
glutInit(&argc, argv);
glutInitWindowSize(420, 420);
glutCreateWindow("Mehedi Hasan Fahim-Flag of Greenland");
glutDisplayFunc(display);
glutMainLoop();
return 0;
}
