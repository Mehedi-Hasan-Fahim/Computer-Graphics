/*
 * drawSky() - Draws the sky
 *
 * A quadrilateral is drawn using four corner points with GL_QUADS.
 * Day: Dark blue (top) to light blue (bottom) - gradient effect
 * Night: Dark black-blue to slightly lighter blue
 *
 * In OpenGL, setting color before each vertex creates a gradient (slow color change)
 */
void drawSky() {
    glBegin(GL_QUADS);
    if (isDayMode) {
        // Day sky: Dark blue at top
        glColor3f(0.15f, 0.35f, 0.75f);
        glVertex2f(-1.0f, 1.0f);  // Top-left corner
        glVertex2f( 1.0f, 1.0f);  // Top-right corner
        // Light sky blue at bottom (creates gradient)
        glColor3f(0.55f, 0.78f, 0.95f);
        glVertex2f( 1.0f, LINE_TOP); // Bottom-right corner
        glVertex2f(-1.0f, LINE_TOP); // Bottom-left corner
    } else {
        // Night sky: Almost black at top
        glColor3f(0.02f, 0.05f, 0.15f);
        glVertex2f(-1.0f, 1.0f);
        glVertex2f( 1.0f, 1.0f);
        // Slightly lighter blue at bottom
        glColor3f(0.1f, 0.15f, 0.3f);
        glVertex2f( 1.0f, LINE_TOP);
        glVertex2f(-1.0f, LINE_TOP);
    }
    glEnd();
}


