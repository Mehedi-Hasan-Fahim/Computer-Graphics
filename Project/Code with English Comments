/*
 * drawStars() - Draws stars in night sky
 *
 * If isDayMode is true, function returns immediately (stars not shown)
 * Points (stars) are drawn at specific positions using GL_POINTS
 * Point size is determined using glPointSize(2.5f)
 */
void drawStars() {
    if (isDayMode) return; // Stars will not show during day

    glColor3f(1.0f, 1.0f, 0.8f); // Light yellowish-white color
    glPointSize(2.5f);            // Star size
    glBegin(GL_POINTS);
    // Positions of 9 stars (manually set)
    glVertex2f( 0.5f,  0.92f); glVertex2f( 0.65f, 0.97f);
    glVertex2f( 0.85f, 0.88f); glVertex2f(-0.45f, 0.95f);
    glVertex2f(-0.55f, 0.80f); glVertex2f( 0.15f, 0.98f);
    glVertex2f( 0.92f, 0.95f); glVertex2f(-0.25f, 0.85f);
    glVertex2f(-0.15f, 0.92f);
    glEnd();
}


// ============================================================
//          GROUND LAYERS (Ground Layers - Different colors)
// ============================================================

/*
 * drawGround() - Draws different layers of the ground
 *
 * 3 layers are drawn:
 *   Layer 1: LINE_TOP to LINE_MIDDLE -> Green grass
 *   Layer 2: LINE_MIDDLE to LINE_BOTTOM -> Brown soil
 *   Layer 3: LINE_BOTTOM to -1.0 -> Dark brown deep soil
 *
 * Finally, two dark lines separate the layers
 */
void drawGround() {
    // ===== Layer 1: Green grass (top layer) =====
    glBegin(GL_QUADS);
    glColor3f(0.35f, 0.70f, 0.25f); // Dark green (top)
    glVertex2f(-1.0f, LINE_TOP); glVertex2f( 1.0f, LINE_TOP);
    glColor3f(0.45f, 0.80f, 0.30f); // Light green (bottom) - gradient
    glVertex2f( 1.0f, LINE_MIDDLE); glVertex2f(-1.0f, LINE_MIDDLE);
    glEnd();

    // ===== Layer 2: Brown soil (middle layer) =====
    glBegin(GL_QUADS);
    glColor3f(0.72f, 0.55f, 0.30f); // Light brown (top)
    glVertex2f(-1.0f, LINE_MIDDLE); glVertex2f( 1.0f, LINE_MIDDLE);
    glColor3f(0.60f, 0.45f, 0.25f); // Slightly darker brown (bottom)
    glVertex2f( 1.0f, LINE_BOTTOM); glVertex2f(-1.0f, LINE_BOTTOM);
    glEnd();

    // ===== Layer 3: Dark brown (bottom layer) =====
    glBegin(GL_QUADS);
    glColor3f(0.45f, 0.35f, 0.20f); // Dark brown (top)
    glVertex2f(-1.0f, LINE_BOTTOM); glVertex2f( 1.0f, LINE_BOTTOM);
    glColor3f(0.35f, 0.25f, 0.15f); // Even darker (bottom)
    glVertex2f( 1.0f, -1.0f); glVertex2f(-1.0f, -1.0f);
    glEnd();

    // ===== Layer separating lines =====
    glColor3f(0.2f, 0.15f, 0.05f); // Black-brown line
    glLineWidth(2.0f);
    glBegin(GL_LINES);
    // Middle separating line
    glVertex2f(-1.0f, LINE_MIDDLE); glVertex2f(1.0f, LINE_MIDDLE);
    // Bottom separating line
    glVertex2f(-1.0f, LINE_BOTTOM); glVertex2f(1.0f, LINE_BOTTOM);
    glEnd();
    glLineWidth(1.0f);
}

/*
 * drawGrassBlades() - Draws grass blades
 *
 * Grass blades are drawn upwards from LINE_MIDDLE at specific X positions.
 * 3 blades are drawn at each position (tilted-left, tilted-right, straight).
 */
void drawGrassBlades() {
    glColor3f(0.20f, 0.55f, 0.15f); // Dark green
    glLineWidth(1.5f);

    // X positions for drawing grass (grass in 18 places)
    float grassX[] = {-0.95f,-0.85f,-0.75f,-0.55f,-0.45f,-0.35f,-0.25f,
                       0.25f, 0.35f, 0.45f, 0.55f, 0.75f, 0.85f, 0.95f,
                      -0.15f, 0.15f, -0.65f, 0.65f};
    int n = 18;
    for (int i = 0; i < n; i++) {
        float x = grassX[i];
        float baseY = LINE_MIDDLE; // Base of grass at ground boundary
        glBegin(GL_LINES);
        // Left-tilted blade
        glVertex2f(x, baseY);          glVertex2f(x - 0.01f, baseY + 0.04f);
        // Right-tilted blade (slightly longer)
        glVertex2f(x, baseY);          glVertex2f(x + 0.015f, baseY + 0.05f);
        // Straight blade
        glVertex2f(x + 0.01f, baseY);  glVertex2f(x + 0.005f, baseY + 0.035f);
        glEnd();
    }
    glLineWidth(1.0f);
}

/*
 * drawTree() - Draws a tree
 * Parameters:
 *   x     : Tree's X position
 *   baseY : Tree's base Y position
 *
 * Tree = Brown trunk (quadrilateral) + Green leaves (3 overlapping circles)
 */
void drawTree(float x, float baseY) {
    // Tree trunk (brown quadrilateral)
    glColor3f(0.45f, 0.30f, 0.15f);
    glBegin(GL_QUADS);
    glVertex2f(x - 0.02f, baseY);          // Bottom-left
    glVertex2f(x + 0.02f, baseY);          // Bottom-right
    glVertex2f(x + 0.02f, baseY + 0.15f);  // Top-right
    glVertex2f(x - 0.02f, baseY + 0.15f);  // Top-left
    glEnd();

    // Tree leaves (combination of green circles)
    glColor3f(0.15f, 0.60f, 0.15f);
    drawFilledCircle(x,         baseY + 0.22f, 0.07f); // Large center circle
    drawFilledCircle(x - 0.05f, baseY + 0.18f, 0.06f); // Left circle
    drawFilledCircle(x + 0.05f, baseY + 0.18f, 0.06f); // Right circle

    // Dark border of leaves
    glColor3f(0.10f, 0.40f, 0.10f);
    drawCircleOutline(x,         baseY + 0.22f, 0.07f);
    drawCircleOutline(x - 0.05f, baseY + 0.18f, 0.06f);
    drawCircleOutline(x + 0.05f, baseY + 0.18f, 0.06f);
}

/*
 * drawTrees() - Draws 4 trees (at ends and middle)
 * Trees start from green ground using LINE_TOP - offset
 */
void drawTrees() {
    drawTree(-0.88f, LINE_TOP - 0.03f); // Far left end
    drawTree(-0.40f, LINE_TOP - 0.02f); // Left-middle
    drawTree( 0.42f, LINE_TOP - 0.02f); // Right-middle
    drawTree( 0.88f, LINE_TOP - 0.03f); // Far right end
}

/*
 * drawPathway() - Draws a path/road
 *
 * Drawn in 3 steps:
 *   1. Striped line (dashes to show path edges)
 *   2. Random points (to show soil grains/stones)
 *   3. Irregular lines (sand texture on path)
 */
void drawPathway() {
    // ===== Path edge dash line =====
    glColor3f(0.55f, 0.40f, 0.20f);
    glLineWidth(3.0f);
    glBegin(GL_LINES);
    for (float px = -1.0f; px < 1.0f; px += 0.15f) {
        // Top dash line
        glVertex2f(px, LINE_MIDDLE - 0.12f);
        glVertex2f(px + 0.08f, LINE_MIDDLE - 0.12f);
        // Bottom dash line
        glVertex2f(px, LINE_MIDDLE - 0.28f);
        glVertex2f(px + 0.08f, LINE_MIDDLE - 0.28f);
    }
    glEnd();
    glLineWidth(1.0f);

    // ===== Path soil grains (random points) =====
    glColor3f(0.65f, 0.45f, 0.25f);
    glPointSize(2.0f);
    glBegin(GL_POINTS);
    // Pseudo-random looking offsets are created using sin() and cos()
    for(float px = -1.0f; px < 1.0f; px += 0.06f) {
        for(float py = LINE_MIDDLE - 0.05f; py > LINE_BOTTOM + 0.05f; py -= 0.08f) {
            // Pseudo-random positions using mathematical tricks
            float offsetX = sin(py * 100.0f + px * 50.0f) * 0.02f;
            float offsetY = cos(px * 80.0f + py * 60.0f) * 0.02f;
            glVertex2f(px + offsetX, py + offsetY);
        }
    }
    glEnd();

    // ===== Sand texture on path (wavy lines) =====
    glColor3f(0.60f, 0.42f, 0.22f);
    glBegin(GL_LINES);
    for (float px = -0.9f; px < 1.0f; px += 0.2f) {
        // Wavy lines using sin()
        float py = LINE_MIDDLE - 0.2f + sin(px * 10.0f) * 0.05f;
        glVertex2f(px, py); glVertex2f(px + 0.05f, py);
    }
    glEnd();
}


// ============================================================
//         NIGHT OVERLAY (Night dark effect)
// ============================================================

/*
 * drawNightOverlay() - Adds a semi-transparent black layer over the ground at night
 *
 * Transparency is enabled by turning on GL_BLEND.
 * The fourth value of glColor4f (alpha = 0.4) means 40% opaque = 60% transparent.
 * This makes the ground visible but appears darkened.
 */
void drawNightOverlay() {
    if (!isDayMode) { // Works only at night
        glEnable(GL_BLEND); // Enable transparency
        glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA); // Blending method

        // Semi-transparent black-blue layer (across the entire ground)
        glColor4f(0.0f, 0.0f, 0.1f, 0.4f); // (R,G,B, Alpha=40%)
        glBegin(GL_QUADS);
        glVertex2f(-1.0f, LINE_TOP); // Top-left
        glVertex2f( 1.0f, LINE_TOP); // Top-right
        glVertex2f( 1.0f, -1.0f);   // Bottom-right
        glVertex2f(-1.0f, -1.0f);   // Bottom-left
        glEnd();
        glDisable(GL_BLEND); // Disable transparency
    }
}


