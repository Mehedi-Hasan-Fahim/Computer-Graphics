/*
 * keyboard() - Handles standard keyboard input
 * Parameters:
 *   key  : ASCII code of pressed character
 *   x, y : Mouse position (not used here)
 *
 * D/d -> Day mode
 * N/n -> Night mode (if no notification)
 * Y/y -> Buy from shop
 * R/r -> Do not buy from shop
 *
 * So it determines what to do by checking showNotification
 */
void keyboard(unsigned char key, int x, int y) {
    if (key == 'D' || key == 'd') {
        isDayMode = true;  // Enable day mode
    } else if (key == 'N' || key == 'n') {
        isDayMode = false; // Enable night mode
    } else if (showNotification) {
        // If Y or N is pressed while notification is showing
        if (key == 'y' || key == 'Y') {
            // Yes - Buy item
            if (currentShop == 1) {
                hasLeftItem = true;   // Bought fruit
                askedLeft = true;     // Will not ask again
            } else if (currentShop == 2) {
                hasRightItem = true;  // Bought balloon
                askedRight = true;    // Will not ask again
            }
            showNotification = false; // Close notification
        } else if (key == 'r' || key == 'R') {
            // No - Will not buy item
            if (currentShop == 1) askedLeft = true;   // Will not ask again
            else if (currentShop == 2) askedRight = true;
            showNotification = false; // Close notification
        }
    }
    glutPostRedisplay(); // Request to redraw screen
}

/*
 * specialKeys() - Handles special keys (Arrow Keys)
 *
 * Character is moved using Arrow Keys.
 * Character's movement boundaries are defined:
 *   X boundary: -0.90 to 0.90 (within screen)
 *   Y boundary: -0.47 to -0.07 (at ground layer)
 */
void specialKeys(int key, int x, int y) {
    if (key == GLUT_KEY_LEFT)  userX -= USER_SPEED; // Go left
    if (key == GLUT_KEY_RIGHT) userX += USER_SPEED; // Go right
    if (key == GLUT_KEY_UP)    userY += USER_SPEED; // Go up
    if (key == GLUT_KEY_DOWN)  userY -= USER_SPEED; // Go down

    // X-axis boundary (will not go off-screen)
    if (userX < -0.90f) userX = -0.90f;
    if (userX >  0.90f) userX =  0.90f;

    // Y-axis boundary (will stay at ground layer)
    if (userY < -0.47f) userY = -0.47f; // Bottom boundary
    if (userY > -0.07f) userY = -0.07f; // Top boundary

    glutPostRedisplay(); // Request to redraw screen
}

/*
 * timer() - Updates animation at specific intervals
 *
 * TIMER_MS (20ms) = 50 frames per second (50 FPS)
 *
 * On each call:
 *   1. Decrease wheelAngle -> Wheel rotates counter-clockwise
 *   2. Increase cloudOffset -> Clouds move right
 *   3. glutPostRedisplay() -> Request to draw next frame
 *   4. glutTimerFunc() -> Schedule next call (repetition)
 */
void timer(int) {
    wheelAngle -= WHEEL_SPEED; // Wheel rotates counter-clockwise (negative = anti-clockwise)
    if (wheelAngle < -360.0f) wheelAngle += 360.0f; // Reset if less than -360

    cloudOffset += CLOUD_SPEED; // Clouds slowly move right

    glutPostRedisplay();              // Request to redraw screen
    glutTimerFunc(TIMER_MS, timer, 0); // Call again after TIMER_MS
}


// ============================================================
//                    MAIN FUNCTION (Main function)
// ============================================================

/*
 * main() - Start of the program
 *
 * Steps:
 *   1. glutInit()           -> Initialize GLUT
 *   2. glutInitDisplayMode() -> Double buffer (smooth animation) + RGB color mode
 *   3. glutInitWindowSize()  -> 1000x700 pixel window
 *   4. glutCreateWindow()    -> Create window
 *   5. glEnable(GL_BLEND)   -> Enable transparency
 *   6. Register callback functions
 *   7. glutMainLoop()        -> Start GLUT event loop (infinite loop)
 *
 * Why Double Buffering?
 *   With a single buffer, screen flickering is visible during drawing.
 *   Double buffer = Draw in one buffer, show the other, then swap.
 *   The two buffers are swapped using glutSwapBuffers().
 */
int main(int argc, char** argv) {
    glutInit(&argc, argv);                              // GLUT initial setup
    glutInitDisplayMode(GLUT_DOUBLE | GLUT_RGB);        // Double buffer + RGB mode
    glutInitWindowSize(900, 600);                      // Window size: 1000x700
    glutCreateWindow("Interactive Village Fair - Graphics Project"); // Create window

    // Enabling transparency
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA); // Alpha blending method

    // ===== Registering Callback Functions =====
    glutDisplayFunc(display);      // Screen drawing function
    glutKeyboardFunc(keyboard);    // Standard key press function
    glutSpecialFunc(specialKeys);  // Special key (Arrow) press function
    glutTimerFunc(0, timer, 0);    // Animation timer (first call after 0ms)

    glutMainLoop(); // Start GLUT event loop (program stays here)
    return 0;       // End of program (never reaches this line)
}
