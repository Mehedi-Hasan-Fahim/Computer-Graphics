/*
 * drawStars() - রাতের আকাশে তারা আঁকে
 *
 * isDayMode সত্য হলে ফাংশন সঙ্গে সঙ্গে return করে (তারা দেখায় না)
 * GL_POINTS দিয়ে নির্দিষ্ট অবস্থানে বিন্দু (তারা) আঁকা হয়
 * glPointSize(2.5f) দিয়ে বিন্দুর আকার নির্ধারণ করা হয়
 */
void drawStars() {
    if (isDayMode) return; // দিনে তারা দেখাবে না

    glColor3f(1.0f, 1.0f, 0.8f); // হালকা হলুদাভ সাদা রঙ
    glPointSize(2.5f);            // তারার আকার
    glBegin(GL_POINTS);
    // ৯টি তারার অবস্থান (হাতে নির্ধারিত)
    glVertex2f( 0.5f,  0.92f); glVertex2f( 0.65f, 0.97f);
    glVertex2f( 0.85f, 0.88f); glVertex2f(-0.45f, 0.95f);
    glVertex2f(-0.55f, 0.80f); glVertex2f( 0.15f, 0.98f);
    glVertex2f( 0.92f, 0.95f); glVertex2f(-0.25f, 0.85f);
    glVertex2f(-0.15f, 0.92f);
    glEnd();
}


// ============================================================
//          GROUND LAYERS (মাটির স্তর - বিভিন্ন রঙে)
// ============================================================

/*
 * drawGround() - মাটির বিভিন্ন স্তর আঁকে
 *
 * ৩টি স্তর আঁকা হয়:
 *   স্তর ১: LINE_TOP থেকে LINE_MIDDLE → সবুজ ঘাস
 *   স্তর ২: LINE_MIDDLE থেকে LINE_BOTTOM → বাদামি মাটি
 *   স্তর ৩: LINE_BOTTOM থেকে -1.0 → গাঢ় বাদামি গভীর মাটি
 *
 * শেষে দুটো গাঢ় রেখা দিয়ে স্তরগুলো আলাদা করা হয়
 */
void drawGround() {
    // ===== স্তর ১: সবুজ ঘাস (উপরের স্তর) =====
    glBegin(GL_QUADS);
    glColor3f(0.35f, 0.70f, 0.25f); // গাঢ় সবুজ (উপরে)
    glVertex2f(-1.0f, LINE_TOP); glVertex2f( 1.0f, LINE_TOP);
    glColor3f(0.45f, 0.80f, 0.30f); // হালকা সবুজ (নিচে) - gradient
    glVertex2f( 1.0f, LINE_MIDDLE); glVertex2f(-1.0f, LINE_MIDDLE);
    glEnd();

    // ===== স্তর ২: বাদামি মাটি (মাঝের স্তর) =====
    glBegin(GL_QUADS);
    glColor3f(0.72f, 0.55f, 0.30f); // হালকা বাদামি (উপরে)
    glVertex2f(-1.0f, LINE_MIDDLE); glVertex2f( 1.0f, LINE_MIDDLE);
    glColor3f(0.60f, 0.45f, 0.25f); // একটু গাঢ় বাদামি (নিচে)
    glVertex2f( 1.0f, LINE_BOTTOM); glVertex2f(-1.0f, LINE_BOTTOM);
    glEnd();

    // ===== স্তর ৩: গাঢ় বাদামি (নিচের স্তর) =====
    glBegin(GL_QUADS);
    glColor3f(0.45f, 0.35f, 0.20f); // গাঢ় বাদামি (উপরে)
    glVertex2f(-1.0f, LINE_BOTTOM); glVertex2f( 1.0f, LINE_BOTTOM);
    glColor3f(0.35f, 0.25f, 0.15f); // আরও গাঢ় (নিচে)
    glVertex2f( 1.0f, -1.0f); glVertex2f(-1.0f, -1.0f);
    glEnd();

    // ===== স্তর বিভাজনকারী রেখা =====
    glColor3f(0.2f, 0.15f, 0.05f); // কালো-বাদামি রেখা
    glLineWidth(2.0f);
    glBegin(GL_LINES);
    // মাঝের বিভাজন রেখা
    glVertex2f(-1.0f, LINE_MIDDLE); glVertex2f(1.0f, LINE_MIDDLE);
    // নিচের বিভাজন রেখা
    glVertex2f(-1.0f, LINE_BOTTOM); glVertex2f(1.0f, LINE_BOTTOM);
    glEnd();
    glLineWidth(1.0f);
}

/*
 * drawGrassBlades() - ঘাসের পাতা আঁকে
 *
 * নির্দিষ্ট X অবস্থানে LINE_MIDDLE রেখা থেকে উপরে ঘাসের পাতা আঁকা হয়।
 * প্রতিটি অবস্থানে ৩টি করে পাতা আঁকা হয় (বাম-কাত, ডান-কাত, সোজা)।
 */
void drawGrassBlades() {
    glColor3f(0.20f, 0.55f, 0.15f); // গাঢ় সবুজ
    glLineWidth(1.5f);

    // ঘাস আঁকার X অবস্থানগুলো (18টি জায়গায় ঘাস)
    float grassX[] = {-0.95f,-0.85f,-0.75f,-0.55f,-0.45f,-0.35f,-0.25f,
                       0.25f, 0.35f, 0.45f, 0.55f, 0.75f, 0.85f, 0.95f,
                      -0.15f, 0.15f, -0.65f, 0.65f};
    int n = 18;
    for (int i = 0; i < n; i++) {
        float x = grassX[i];
        float baseY = LINE_MIDDLE; // ঘাসের গোড়া মাটির সীমায়
        glBegin(GL_LINES);
        // বাম দিকে বাঁকা পাতা
        glVertex2f(x, baseY);          glVertex2f(x - 0.01f, baseY + 0.04f);
        // ডান দিকে বাঁকা পাতা (একটু লম্বা)
        glVertex2f(x, baseY);          glVertex2f(x + 0.015f, baseY + 0.05f);
        // সোজা পাতা
        glVertex2f(x + 0.01f, baseY);  glVertex2f(x + 0.005f, baseY + 0.035f);
        glEnd();
    }
    glLineWidth(1.0f);
}

/*
 * drawTree() - একটি গাছ আঁকে
 * Parameters:
 *   x     : গাছের X অবস্থান
 *   baseY : গাছের গোড়ার Y অবস্থান
 *
 * গাছ = বাদামি কাণ্ড (চতুর্ভুজ) + সবুজ পাতা (৩টি ওভারল্যাপিং বৃত্ত)
 */
void drawTree(float x, float baseY) {
    // গাছের কাণ্ড (বাদামি চতুর্ভুজ)
    glColor3f(0.45f, 0.30f, 0.15f);
    glBegin(GL_QUADS);
    glVertex2f(x - 0.02f, baseY);          // নিচ-বাম
    glVertex2f(x + 0.02f, baseY);          // নিচ-ডান
    glVertex2f(x + 0.02f, baseY + 0.15f);  // উপর-ডান
    glVertex2f(x - 0.02f, baseY + 0.15f);  // উপর-বাম
    glEnd();

    // গাছের পাতা (সবুজ বৃত্তের সমষ্টি)
    glColor3f(0.15f, 0.60f, 0.15f);
    drawFilledCircle(x,         baseY + 0.22f, 0.07f); // মাঝের বড় বৃত্ত
    drawFilledCircle(x - 0.05f, baseY + 0.18f, 0.06f); // বাম বৃত্ত
    drawFilledCircle(x + 0.05f, baseY + 0.18f, 0.06f); // ডান বৃত্ত

    // পাতার গাঢ় বর্ডার
    glColor3f(0.10f, 0.40f, 0.10f);
    drawCircleOutline(x,         baseY + 0.22f, 0.07f);
    drawCircleOutline(x - 0.05f, baseY + 0.18f, 0.06f);
    drawCircleOutline(x + 0.05f, baseY + 0.18f, 0.06f);
}

/*
 * drawTrees() - ৪টি গাছ আঁকে (দুই প্রান্তে ও মাঝে)
 * LINE_TOP - offset দিয়ে গাছ সবুজ মাটির উপর থেকে শুরু হয়
 */
void drawTrees() {
    drawTree(-0.88f, LINE_TOP - 0.03f); // একদম বাম প্রান্ত
    drawTree(-0.40f, LINE_TOP - 0.02f); // বাম-মাঝ
    drawTree( 0.42f, LINE_TOP - 0.02f); // ডান-মাঝ
    drawTree( 0.88f, LINE_TOP - 0.03f); // একদম ডান প্রান্ত
}

/*
 * drawPathway() - পথ/রাস্তা আঁকে
 *
 * ৩ ধাপে আঁকা হয়:
 *   ১. স্ট্রাইপড লাইন (ড্যাশ দিয়ে বোঝানো যে পথের কিনারা)
 *   ২. র‍্যান্ডম বিন্দু (মাটির দানা/পাথর দেখানোর জন্য)
 *   ৩. অনিয়মিত রেখা (পথের উপর বালুর টেক্সচার)
 */
void drawPathway() {
    // ===== পথের কিনারার ড্যাশ লাইন =====
    glColor3f(0.55f, 0.40f, 0.20f);
    glLineWidth(3.0f);
    glBegin(GL_LINES);
    for (float px = -1.0f; px < 1.0f; px += 0.15f) {
        // উপরের ড্যাশ লাইন
        glVertex2f(px, LINE_MIDDLE - 0.12f);
        glVertex2f(px + 0.08f, LINE_MIDDLE - 0.12f);
        // নিচের ড্যাশ লাইন
        glVertex2f(px, LINE_MIDDLE - 0.28f);
        glVertex2f(px + 0.08f, LINE_MIDDLE - 0.28f);
    }
    glEnd();
    glLineWidth(1.0f);

    // ===== পথের মাটির দানা (র‍্যান্ডম বিন্দু) =====
    glColor3f(0.65f, 0.45f, 0.25f);
    glPointSize(2.0f);
    glBegin(GL_POINTS);
    // sin() ও cos() দিয়ে র‍্যান্ডম দেখানো অফসেট তৈরি হচ্ছে
    for(float px = -1.0f; px < 1.0f; px += 0.06f) {
        for(float py = LINE_MIDDLE - 0.05f; py > LINE_BOTTOM + 0.05f; py -= 0.08f) {
            // গাণিতিক কৌশলে pseudo-random অবস্থান
            float offsetX = sin(py * 100.0f + px * 50.0f) * 0.02f;
            float offsetY = cos(px * 80.0f + py * 60.0f) * 0.02f;
            glVertex2f(px + offsetX, py + offsetY);
        }
    }
    glEnd();

    // ===== পথের উপর বালুর টেক্সচার (ঢেউ খেলানো রেখা) =====
    glColor3f(0.60f, 0.42f, 0.22f);
    glBegin(GL_LINES);
    for (float px = -0.9f; px < 1.0f; px += 0.2f) {
        // sin() দিয়ে ঢেউ খেলানো রেখা
        float py = LINE_MIDDLE - 0.2f + sin(px * 10.0f) * 0.05f;
        glVertex2f(px, py); glVertex2f(px + 0.05f, py);
    }
    glEnd();
}


// ============================================================
//         NIGHT OVERLAY (রাতের অন্ধকার প্রভাব)
// ============================================================

/*
 * drawNightOverlay() - রাতে মাটির উপর আধা-স্বচ্ছ কালো স্তর দেয়
 *
 * GL_BLEND চালু করে স্বচ্ছতা (transparency) সক্রিয় করা হয়।
 * glColor4f এর চতুর্থ মান (alpha = 0.4) মানে 40% অপ্যাক = 60% স্বচ্ছ।
 * এতে মাটি দেখা যায় কিন্তু অন্ধকারাচ্ছন্ন দেখায়।
 */
void drawNightOverlay() {
    if (!isDayMode) { // শুধু রাতে কাজ করবে
        glEnable(GL_BLEND); // transparency চালু
        glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA); // মিশ্রণ পদ্ধতি

        // আধা-স্বচ্ছ কালো-নীল স্তর (সম্পূর্ণ মাটি জুড়ে)
        glColor4f(0.0f, 0.0f, 0.1f, 0.4f); // (R,G,B, Alpha=40%)
        glBegin(GL_QUADS);
        glVertex2f(-1.0f, LINE_TOP); // উপর-বাম
        glVertex2f( 1.0f, LINE_TOP); // উপর-ডান
        glVertex2f( 1.0f, -1.0f);   // নিচ-ডান
        glVertex2f(-1.0f, -1.0f);   // নিচ-বাম
        glEnd();
        glDisable(GL_BLEND); // transparency বন্ধ
    }
}


// ============================================================
//        INTERACTIVE USER CHARACTER (ব্যবহারকারীর চরিত্র)
// ============================================================

/*
 * drawUser() - মূল খেলোয়াড়ের চরিত্র আঁকে
 * Parameters:
 *   cx, cy : চরিত্রের কেন্দ্র অবস্থান
 *
 * চরিত্রের অংশসমূহ (নিচ থেকে উপর):
 *   ১. জুতা (লাল চতুর্ভুজ)
 *   ২. প্যান্ট (গাঢ় নীল দুটো পা)
 *   ৩. জামা (হলুদ, বুকে কমলা বোতাম)
 *   ৪. হাত (ত্বকের রঙের মোটা রেখা + তালু বৃত্ত)
 *   ৫. ইনভেন্টরি আইটেম (বেলুন বা ফলের ঝুড়ি)
 *   ৬. গলা
 *   ৭. মাথা ও চুল
 *   ৮. চোখ ও হাসি
 */
void drawUser(float cx, float cy) {

    // ===== প্যান্ট (দুটো পা) =====
    glColor3f(0.15f, 0.25f, 0.45f); // গাঢ় নীল জিন্স রঙ
    glBegin(GL_QUADS);
    // বাম পা
    glVertex2f(cx - 0.05f, cy - 0.05f); glVertex2f(cx - 0.01f, cy - 0.05f);
    glVertex2f(cx - 0.01f, cy - 0.28f); glVertex2f(cx - 0.05f, cy - 0.28f);
    // ডান পা
    glVertex2f(cx + 0.01f, cy - 0.05f); glVertex2f(cx + 0.05f, cy - 0.05f);
    glVertex2f(cx + 0.05f, cy - 0.28f); glVertex2f(cx + 0.01f, cy - 0.28f);
    glEnd();

    // ===== জুতা (দুটো পায়ের নিচে লাল বাক্স) =====
    glColor3f(0.8f, 0.2f, 0.1f); // লাল রঙ
    glBegin(GL_QUADS);
    // বাম জুতা
    glVertex2f(cx - 0.06f, cy - 0.28f); glVertex2f(cx - 0.01f, cy - 0.28f);
    glVertex2f(cx - 0.01f, cy - 0.33f); glVertex2f(cx - 0.06f, cy - 0.33f);
    // ডান জুতা
    glVertex2f(cx + 0.01f, cy - 0.28f); glVertex2f(cx + 0.06f, cy - 0.28f);
    glVertex2f(cx + 0.06f, cy - 0.33f); glVertex2f(cx + 0.01f, cy - 0.33f);
    glEnd();

    // ===== জামার মূল অংশ (হলুদ চতুর্ভুজ) =====
    glColor3f(0.95f, 0.75f, 0.15f); // উজ্জ্বল হলুদ
    glBegin(GL_QUADS);
    glVertex2f(cx - 0.07f, cy + 0.14f); // উপর-বাম কাঁধ
    glVertex2f(cx + 0.07f, cy + 0.14f); // উপর-ডান কাঁধ
    glVertex2f(cx + 0.08f, cy - 0.12f); // নিচ-ডান
    glVertex2f(cx - 0.08f, cy - 0.12f); // নিচ-বাম
    glEnd();

    // ===== জামার বোতাম (কমলা ডিজাইন) =====
    glColor3f(0.85f, 0.45f, 0.10f); // কমলা রঙ
    glBegin(GL_QUADS);
    glVertex2f(cx - 0.02f, cy + 0.14f); glVertex2f(cx + 0.02f, cy + 0.14f);
    glVertex2f(cx + 0.02f, cy + 0.05f); glVertex2f(cx - 0.02f, cy + 0.05f);
    glEnd();

    // ===== হাত (মোটা রেখা দিয়ে আঁকা) =====
    glColor3f(0.95f, 0.75f, 0.60f); // ত্বকের রঙ
    glLineWidth(6.0f); // মোটা রেখা দিয়ে হাত দেখাচ্ছে
    glBegin(GL_LINES);
    // বাম হাত (নিচের দিকে ঝুলছে)
    glVertex2f(cx - 0.07f, cy + 0.12f); glVertex2f(cx - 0.12f, cy - 0.02f);
    // ডান হাত (উপরের দিকে উঠানো - ইন্টারেক্টিভ ভঙ্গি)
    glVertex2f(cx + 0.07f, cy + 0.12f); glVertex2f(cx + 0.14f, cy + 0.18f);
    glEnd();
    // হাতের তালু (ছোট ভরা বৃত্ত)
    drawFilledCircle(cx - 0.12f, cy - 0.02f, 0.025f); // বাম তালু
    drawFilledCircle(cx + 0.14f, cy + 0.18f, 0.025f); // ডান তালু
    glLineWidth(1.0f);

    // ============================================================
    //       INVENTORY ITEMS (ক্রয় করা আইটেম দেখানো)
    // ============================================================

    /*
     * hasRightItem = true হলে ডান হাতে বেলুন দেখানো হয়
     * বেলুন: একটি সুতা (LINE_STRIP) + উপবৃত্তাকার বৃত্ত + ছোট ত্রিভুজ (নিচের গাঁট)
     */
  if (hasRightItem) {
        // বেলুনের সুতা (ঢেউ খেলানো রেখা)
        glColor3f(0.9f, 0.9f, 0.9f); // হালকা ধূসর সুতা
        glLineWidth(1.5f);
        glBegin(GL_LINE_STRIP);
        glVertex2f(cx + 0.15f, cy + 0.34f);  // বেলুনের নিচের গাঁট থেকে শুরু
        glVertex2f(cx + 0.13f, cy + 0.28f);  // বাঁকানো সুতা (বামে)
        glVertex2f(cx + 0.16f, cy + 0.23f);  // বাঁকানো সুতা (ডানে)
        glVertex2f(cx + 0.14f, cy + 0.18f);  // হাতের তালু পর্যন্ত
        glEnd();

        // বেলুনের মূল অংশ (উপবৃত্ত - উল্লম্বভাবে লম্বা)
        glPushMatrix();
        glTranslatef(cx + 0.15f, cy + 0.38f, 0.0f);
        glScalef(1.0f, 1.25f, 1.0f); // Y দিকে বড় করে উপবৃত্ত তৈরি
        glColor3f(0.1f * 0.7f, 0.7f * 0.7f, 1.0f * 0.7f); // গাঢ় নীল শেড
        drawFilledCircle(0.0f, 0.0f, 0.035f);              // বাইরের বৃত্ত
        glColor3f(0.1f, 0.7f, 1.0f);                       // উজ্জ্বল নীল
        drawFilledCircle(-0.005f, 0.005f, 0.025f);          // ভেতরের হাইলাইট
        glPopMatrix();

        // বেলুনের নিচের গাঁট (ছোট ত্রিভুজ)
        glColor3f(0.1f * 0.7f, 0.7f * 0.7f, 1.0f * 0.7f);
        glBegin(GL_TRIANGLES);
        glVertex2f(cx + 0.15f, cy + 0.34f);   // উপর বিন্দু
        glVertex2f(cx + 0.14f, cy + 0.325f);  // নিচ-বাম
        glVertex2f(cx + 0.16f, cy + 0.325f);  // নিচ-ডান
        glEnd();

        // বেলুনের আলোর প্রতিফলন (সাদা ছোট বৃত্ত)
        glColor3f(1.0f, 1.0f, 1.0f);
        glPushMatrix();
        glTranslatef(cx + 0.15f, cy + 0.38f, 0.0f);
        glScalef(1.0f, 2.0f, 1.0f);
        drawFilledCircle(-0.015f, 0.008f, 0.005f); // ছোট সাদা বিন্দু
        glPopMatrix();
    }

    /*
     * hasLeftItem = true হলে বাম হাতে ফলের ঝুড়ি দেখানো হয়
     * ঝুড়ি: বাদামি হ্যান্ডেল (LINE_STRIP) + বাদামি বাক্স + উপরে একটি আপেল
     */
    if (hasLeftItem) {
        // ঝুড়ির হ্যান্ডেল (U আকৃতির রেখা)
        glColor3f(0.5f, 0.3f, 0.1f); // বাদামি
        glLineWidth(2.0f);
        glBegin(GL_LINE_STRIP);
        glVertex2f(cx - 0.14f, cy - 0.02f); // বাম উপরে
        glVertex2f(cx - 0.14f, cy - 0.08f); // বাম নিচে
        glVertex2f(cx - 0.10f, cy - 0.08f); // ডান নিচে
        glVertex2f(cx - 0.10f, cy - 0.02f); // ডান উপরে
        glEnd();
        glLineWidth(1.0f);

        // ঝুড়ির মূল অংশ (ট্রাপিজিয়াম আকৃতি - উপরে চওড়া, নিচে সরু)
        glColor3f(0.85f, 0.65f, 0.35f); // হালকা বাদামি
        glBegin(GL_QUADS);
        glVertex2f(cx - 0.16f, cy - 0.08f); // উপর-বাম
        glVertex2f(cx - 0.08f, cy - 0.08f); // উপর-ডান
        glVertex2f(cx - 0.09f, cy - 0.18f); // নিচ-ডান
        glVertex2f(cx - 0.15f, cy - 0.18f); // নিচ-বাম
        glEnd();

        // ঝুড়ির উপরের রিম (গাঢ় বাদামি পট্টি)
        glColor3f(0.65f, 0.45f, 0.20f);
        glBegin(GL_QUADS);
        glVertex2f(cx - 0.16f, cy - 0.08f); glVertex2f(cx - 0.08f, cy - 0.08f);
        glVertex2f(cx - 0.085f, cy - 0.10f); glVertex2f(cx - 0.155f, cy - 0.10f);
        glEnd();

        // ঝুড়ির উপরে আপেল
        glPushMatrix();
        glTranslatef(cx - 0.12f, cy - 0.06f, 0.0f);
        glColor3f(0.7f, 0.0f, 0.0f);           // গাঢ় লাল আপেল
        drawFilledCircle(0.0f, 0.0f, 0.025f);
        glColor3f(1.0f, 0.2f, 0.2f);           // উজ্জ্বল লাল হাইলাইট
        drawFilledCircle(-0.006f, 0.006f, 0.012f);
        // আপেলের বোঁটা
        glColor3f(0.3f, 0.15f, 0.0f); glLineWidth(2.0f);
        glBegin(GL_LINES); glVertex2f(0.0f, 0.02f); glVertex2f(0.008f, 0.035f); glEnd();
        // আপেলের পাতা
        glColor3f(0.1f, 0.6f, 0.1f);
        glBegin(GL_TRIANGLES);
        glVertex2f(0.008f, 0.025f); glVertex2f(0.025f, 0.035f); glVertex2f(0.018f, 0.012f);
        glEnd();
        glPopMatrix();
    }

    // ===== গলা =====
    glColor3f(0.95f, 0.75f, 0.60f); // ত্বকের রঙ
    glBegin(GL_QUADS);
    glVertex2f(cx - 0.02f, cy + 0.14f); glVertex2f(cx + 0.02f, cy + 0.14f);
    glVertex2f(cx + 0.02f, cy + 0.18f); glVertex2f(cx - 0.02f, cy + 0.18f);
    glEnd();

    // ===== মাথা (ত্বকের রঙের বৃত্ত) =====
    drawFilledCircle(cx, cy + 0.24f, 0.08f);

    // ===== চুল (কালো অর্ধবৃত্ত + পাশে ছোট বৃত্ত) =====
    glColor3f(0.15f, 0.10f, 0.05f); // কালো-বাদামি
    glBegin(GL_POLYGON);
    // মাথার উপরের অর্ধেক কালো করা হচ্ছে
    for (int i = 0; i <= 180; i++) {
        float angle = i * PI / 180.0f;
        glVertex2f(cx + cos(angle) * 0.082f, cy + 0.26f + sin(angle) * 0.06f);
    }
    glEnd();
    // চুলের ঝাঁকড়া অংশ (পাশে বড় বৃত্ত)
    drawFilledCircle(cx - 0.04f, cy + 0.28f, 0.025f);
    drawFilledCircle(cx + 0.02f, cy + 0.29f, 0.030f);
    drawFilledCircle(cx + 0.05f, cy + 0.27f, 0.020f);

    // ===== চোখ (সাদা + কালো মণি + সাদা চকচকে বিন্দু) =====
    glColor3f(1.0f, 1.0f, 1.0f);
    drawFilledCircle(cx - 0.03f, cy + 0.24f, 0.022f); // বাম চোখের সাদা অংশ
    drawFilledCircle(cx + 0.03f, cy + 0.24f, 0.022f); // ডান চোখের সাদা অংশ
    glColor3f(0.0f, 0.0f, 0.0f);
    drawFilledCircle(cx - 0.03f, cy + 0.24f, 0.015f); // বাম মণি (কালো)
    drawFilledCircle(cx + 0.03f, cy + 0.24f, 0.015f); // ডান মণি (কালো)
    glColor3f(1.0f, 1.0f, 1.0f);
    // চোখের চকচকে হাইলাইট বিন্দু
    drawFilledCircle(cx - 0.035f, cy + 0.245f, 0.006f);
    drawFilledCircle(cx + 0.025f, cy + 0.245f, 0.006f);

    // ===== হাসি (বাঁকা রেখা) =====
    glColor3f(0.60f, 0.20f, 0.20f); // গাঢ় লাল ঠোঁটের রঙ
    glLineWidth(2.5f);
    glBegin(GL_LINE_STRIP);
    // 210° থেকে 330° পর্যন্ত বৃত্তের নিচের অংশ - হাসির আকৃতি
    for (int i = 210; i <= 330; i++) {
        float angle = i * PI / 180.0f;
        glVertex2f(cx + cos(angle) * 0.025f, cy + 0.21f + sin(angle) * 0.025f);
    }
    glEnd();
    glLineWidth(1.0f);
}


// ============================================================
//       GENERIC HUMAN FIGURE (সাধারণ মানুষ - দোকানদার ও যাত্রী)
// ============================================================

/*
 * drawHuman() - একটি সাধারণ মানুষের চরিত্র আঁকে
 * Parameters:
 *   x, y    : চরিত্রের কেন্দ্র অবস্থান
 *   r, g, b : জামার রঙ (RGB মান)
 *
 * drawUser() থেকে ছোট এবং সহজ ডিজাইন।
 * দোকানদার ও ফেরিস চাকার যাত্রীদের জন্য ব্যবহার হয়।
 * জামার রঙ প্যারামিটার দিয়ে ভিন্ন ভিন্ন চরিত্র তৈরি করা হয়।
 */
void drawHuman(float x, float y, float r, float g, float b) {

    // ===== শরীর (রঙিন জামা - প্যারামিটার থেকে রঙ নেওয়া হচ্ছে) =====
    glColor3f(r, g, b); // ডায়নামিক জামার রঙ
    glBegin(GL_QUADS);
    // শরীর একটু ট্রাপিজিয়াম আকৃতির (কাঁধ চওড়া)
    glVertex2f(x - 0.035f, y + 0.08f); // উপর-বাম (কাঁধ)
    glVertex2f(x + 0.035f, y + 0.08f); // উপর-ডান (কাঁধ)
    glVertex2f(x + 0.04f,  y);          // নিচ-ডান (কোমর)
    glVertex2f(x - 0.04f,  y);          // নিচ-বাম (কোমর)
    glEnd();

    // জামার কালো বর্ডার (outline)
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(x - 0.035f, y + 0.08f); glVertex2f(x + 0.035f, y + 0.08f);
    glVertex2f(x + 0.04f,  y); glVertex2f(x - 0.04f,  y);
    glEnd();

    // ===== মাথা (ত্বকের রঙের বৃত্ত + কালো বর্ডার) =====
    glColor3f(0.90f, 0.72f, 0.50f); // ত্বকের রঙ
    drawFilledCircle(x, y + 0.12f, 0.04f);
    glColor3f(0.0f, 0.0f, 0.0f);
    drawCircleOutline(x, y + 0.12f, 0.04f);

    // ===== চুল (ছোট সংস্করণ) =====
    glColor3f(0.15f, 0.10f, 0.05f);
    glBegin(GL_POLYGON);
    for (int i = 0; i <= 180; i++) {
        float angle = i * PI / 180.0f;
        glVertex2f(x + cos(angle) * 0.041f, y + 0.13f + sin(angle) * 0.03f);
    }
    glEnd();
    drawFilledCircle(x - 0.02f, y + 0.14f, 0.012f);
    drawFilledCircle(x + 0.01f, y + 0.145f, 0.015f);
    drawFilledCircle(x + 0.025f, y + 0.135f, 0.010f);

    // ===== চোখ (দুটো কালো বিন্দু) =====
    glPointSize(2.5f);
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_POINTS);
    glVertex2f(x - 0.015f, y + 0.125f); // বাম চোখ
    glVertex2f(x + 0.015f, y + 0.125f); // ডান চোখ
    glEnd();

    // ===== হাসি (ছোট বাঁকা রেখা) =====
    glBegin(GL_LINE_STRIP);
    for (int i = 210; i <= 330; i++) {
        float angle = i * PI / 180.0f;
        glVertex2f(x + cos(angle) * 0.02f, (y + 0.115f) + sin(angle) * 0.02f);
    }
    glEnd();

    // ===== হাত (দুটো তির্যক কালো রেখা) =====
    glColor3f(0.0f, 0.0f, 0.0f);
    glLineWidth(2.0f);
    glBegin(GL_LINES);
    // বাম হাত (নিচের দিকে)
    glVertex2f(x - 0.035f, y + 0.06f); glVertex2f(x - 0.07f, y + 0.03f);
    // ডান হাত (নিচের দিকে)
    glVertex2f(x + 0.035f, y + 0.06f); glVertex2f(x + 0.07f, y + 0.03f);
    glEnd();
    glLineWidth(1.0f);
}


// ============================================================
//           LEFT STALL - ফলের দোকান (বাম দিকে)
// ============================================================

/*
 * drawLeftStall() - বাম পাশের ফলের দোকান আঁকে
 *
 * গঠন:
 *   ১. দোকানদার (গোলাপি জামা)
 *   ২. দুটো উল্লম্ব খুঁটি (বাদামি চতুর্ভুজ)
 *   ৩. লাল ছাউনি (ট্রাপিজিয়াম + সাদা স্ট্রাইপ)
 *   ৪. কাউন্টার (বাদামি টেবিল)
 *   ৫. কাউন্টারের উপর ফল (আপেল, কমলা, পেয়ারা, লেবু)
 *   ৬. নিচে বাক্স/ড্রয়ার
 */
void drawLeftStall() {
    float x = LSTALL_X, y = LSTALL_Y; // বাম দোকানের কেন্দ্র অবস্থান

    // দোকানদার আঁকা (গোলাপি জামা পরা)
    drawHuman(x, y + 0.0f, 0.8f, 0.3f, 0.6f);

    // ===== দুটো উল্লম্ব কাঠের খুঁটি =====
    glColor3f(0.55f, 0.35f, 0.15f); // বাদামি কাঠের রঙ
    // বাম খুঁটি
    glBegin(GL_QUADS);
    glVertex2f(x - 0.15f, y); glVertex2f(x - 0.13f, y);
    glVertex2f(x - 0.13f, y + 0.25f); glVertex2f(x - 0.15f, y + 0.25f);
    glEnd();
    // ডান খুঁটি
    glBegin(GL_QUADS);
    glVertex2f(x + 0.13f, y); glVertex2f(x + 0.15f, y);
    glVertex2f(x + 0.15f, y + 0.25f); glVertex2f(x + 0.13f, y + 0.25f);
    glEnd();

    // ===== লাল ছাউনি (trapezoidal roof) =====
    glColor3f(0.85f, 0.15f, 0.15f); // উজ্জ্বল লাল
    glBegin(GL_QUADS);
    // নিচে চওড়া, উপরে সরু - ছাউনির আকৃতি
    glVertex2f(x - 0.22f, y + 0.25f); // নিচ-বাম (চওড়া)
    glVertex2f(x + 0.22f, y + 0.25f); // নিচ-ডান (চওড়া)
    glVertex2f(x + 0.15f, y + 0.40f); // উপর-ডান (সরু)
    glVertex2f(x - 0.15f, y + 0.40f); // উপর-বাম (সরু)
    glEnd();
    // ছাউনির কালো বর্ডার
    glColor3f(0.65f, 0.10f, 0.10f);
    glLineWidth(2.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(x - 0.22f, y + 0.25f); glVertex2f(x + 0.22f, y + 0.25f);
    glVertex2f(x + 0.15f, y + 0.40f); glVertex2f(x - 0.15f, y + 0.40f);
    glEnd();
    glLineWidth(1.0f);

    // ===== ছাউনির সাদা স্ট্রাইপ =====
    glColor3f(1.0f, 1.0f, 1.0f);
    glLineWidth(1.5f);
    for (float stripe = -0.12f; stripe <= 0.12f; stripe += 0.06f) {
        glBegin(GL_LINES);
        glVertex2f(x + stripe, y + 0.26f);           // স্ট্রাইপের নিচ
        glVertex2f(x + stripe * 0.7f, y + 0.39f);    // স্ট্রাইপের উপর (সামান্য কাত)
        glEnd();
    }
    glLineWidth(1.0f);

    // ===== কাউন্টার (বিক্রয় টেবিল) =====
    glColor3f(0.90f, 0.78f, 0.55f); // হালকা বাদামি কাঠ
    glBegin(GL_QUADS);
    // উপরের পাটাতন
    glVertex2f(x - 0.15f, y); glVertex2f(x + 0.15f, y);
    glVertex2f(x + 0.20f, y - 0.15f); glVertex2f(x - 0.20f, y - 0.15f);
    glEnd();
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINE_LOOP); // কাউন্টারের বর্ডার
    glVertex2f(x - 0.15f, y); glVertex2f(x + 0.15f, y);
    glVertex2f(x + 0.20f, y - 0.15f); glVertex2f(x - 0.20f, y - 0.15f);
    glEnd();

    // ===== কাউন্টারের উপর ফল আঁকা =====
    // ---- আপেল ----
    glPushMatrix(); // বর্তমান matrix সংরক্ষণ
    glTranslatef(x - 0.08f, y - 0.12f, 0.0f); // আপেলের অবস্থানে সরানো
    glColor3f(0.7f, 0.0f, 0.0f); drawFilledCircle(0.0f, 0.0f, 0.03f); // গাঢ় লাল
    glColor3f(1.0f, 0.2f, 0.2f); drawFilledCircle(-0.008f, 0.008f, 0.015f); // হাইলাইট
    glColor3f(0.3f, 0.15f, 0.0f); glLineWidth(2.0f);
    glBegin(GL_LINES); glVertex2f(0.0f, 0.025f); glVertex2f(0.01f, 0.045f); glEnd(); // বোঁটা
    glColor3f(0.1f, 0.6f, 0.1f);
    glBegin(GL_TRIANGLES); // পাতা
    glVertex2f(0.01f, 0.03f); glVertex2f(0.03f, 0.04f); glVertex2f(0.02f, 0.015f);
    glEnd();
    glPopMatrix(); // matrix পুনরুদ্ধার

    // ---- কমলা ----
    glPushMatrix();
    glTranslatef(x - 0.02f, y - 0.12f, 0.0f);
    glColor3f(0.9f, 0.4f, 0.0f); drawFilledCircle(0.0f, 0.0f, 0.03f); // কমলা রঙ
    glColor3f(1.0f, 0.6f, 0.1f); drawFilledCircle(-0.005f, 0.005f, 0.02f); // হাইলাইট
    glColor3f(0.1f, 0.4f, 0.1f); drawFilledCircle(0.0f, 0.025f, 0.005f); // বোঁটা
    // কমলার দাগ (texture বিন্দু)
    glPointSize(1.5f); glColor3f(0.8f, 0.3f, 0.0f);
    glBegin(GL_POINTS);
    glVertex2f(0.01f, 0.01f); glVertex2f(-0.01f, -0.01f);
    glVertex2f(0.015f, -0.01f); glVertex2f(-0.005f, 0.015f);
    glEnd();
    glPopMatrix();

    // ---- পেয়ারা (সবুজ) ----
    glPushMatrix();
    glTranslatef(x + 0.04f, y - 0.12f, 0.0f);
    glColor3f(0.2f, 0.7f, 0.1f); drawFilledCircle(0.0f, 0.0f, 0.03f); // সবুজ
    glColor3f(0.4f, 0.9f, 0.3f); drawFilledCircle(-0.008f, 0.008f, 0.015f); // হাইলাইট
    glColor3f(0.3f, 0.15f, 0.0f); glLineWidth(2.0f);
    glBegin(GL_LINES); glVertex2f(0.0f, 0.025f); glVertex2f(-0.01f, 0.045f); glEnd(); // বোঁটা
    glColor3f(0.1f, 0.5f, 0.1f);
    glBegin(GL_TRIANGLES); // পাতা
    glVertex2f(-0.01f, 0.03f); glVertex2f(-0.03f, 0.04f); glVertex2f(-0.02f, 0.015f);
    glEnd();
    glPopMatrix();

    // ---- লেবু (হলুদ উপবৃত্ত) ----
    glPushMatrix();
    glTranslatef(x + 0.10f, y - 0.12f, 0.0f);
    glPushMatrix();
    glScalef(1.2f, 0.9f, 1.0f); // X দিকে বড়, Y দিকে ছোট = উপবৃত্তাকার লেবু
    glColor3f(0.9f, 0.8f, 0.0f); drawFilledCircle(0.0f, 0.0f, 0.025f);
    glColor3f(1.0f, 1.0f, 0.4f); drawFilledCircle(-0.005f, 0.005f, 0.015f);
    glPopMatrix();
    // লেবুর দুই পাশে ছোট বৃত্ত (লেবুর মাথা)
    glColor3f(0.9f, 0.8f, 0.0f);
    drawFilledCircle(-0.028f, 0.0f, 0.006f);
    drawFilledCircle(0.028f, 0.0f, 0.006f);
    glPopMatrix();
    glLineWidth(1.0f);

    // ===== নিচের স্টোরেজ বাক্স =====
    glColor3f(0.75f, 0.60f, 0.40f);
    glBegin(GL_QUADS);
    glVertex2f(x - 0.20f, y - 0.15f); glVertex2f(x + 0.20f, y - 0.15f);
    glVertex2f(x + 0.20f, y - 0.35f); glVertex2f(x - 0.20f, y - 0.35f);
    glEnd();
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(x - 0.20f, y - 0.15f); glVertex2f(x + 0.20f, y - 0.15f);
    glVertex2f(x + 0.20f, y - 0.35f); glVertex2f(x - 0.20f, y - 0.35f);
    glEnd();
}


// ============================================================
//          RIGHT STALL - বেলুনের দোকান (ডান দিকে)
// ============================================================

/*
 * drawRightStall() - ডান পাশের বেলুনের দোকান আঁকে
 *
 * গঠন:
 *   ১. দোকানদার (সবুজ জামা)
 *   ২. কাউন্টার বাক্স
 *   ৩. তিনটি রঙিন বেলুন (কাউন্টারের উপরে)
 *   ৪. একটি চাকা (সাইড ডেকোরেশন)
 *   ৫. দুটো খুঁটি + নীল ছাউনি
 */
void drawRightStall() {
    float x = RSTALL_X, y = RSTALL_Y; // ডান দোকানের কেন্দ্র

    // দোকানদার আঁকা (সবুজ জামা পরা)
    drawHuman(x, y + 0.0f, 0.2f, 0.8f, 0.4f);

    // ===== কাউন্টার বাক্স =====
    glColor3f(0.90f, 0.78f, 0.55f); // বাদামি কাঠ
    glBegin(GL_QUADS);
    glVertex2f(x - 0.15f, y); glVertex2f(x + 0.15f, y);
    glVertex2f(x + 0.15f, y - 0.30f); glVertex2f(x - 0.15f, y - 0.30f);
    glEnd();
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINE_LOOP); // বর্ডার
    glVertex2f(x - 0.15f, y); glVertex2f(x + 0.15f, y);
    glVertex2f(x + 0.15f, y - 0.30f); glVertex2f(x - 0.15f, y - 0.30f);
    glEnd();

    // ===== তিনটি রঙিন বেলুন =====
    // বেলুনের রঙ (গোলাপি, নীল, হলুদ)
    float balloonColors[3][3] = {
        {1.0f, 0.2f, 0.5f},  // গোলাপি
        {0.1f, 0.7f, 1.0f},  // আকাশি নীল
        {1.0f, 0.9f, 0.1f}   // উজ্জ্বল হলুদ
    };
    // বেলুনের অবস্থান (বাম, মাঝ, ডান)
    float balloonPos[3][2] = {
        {x - 0.10f, y + 0.10f}, // বাম বেলুন (একটু উঁচুতে)
        {x + 0.00f, y + 0.03f}, // মাঝের বেলুন (একটু নিচে)
        {x + 0.10f, y + 0.10f}  // ডান বেলুন (একটু উঁচুতে)
    };

    for(int i = 0; i < 3; i++) {
        glPushMatrix();
        glTranslatef(balloonPos[i][0], balloonPos[i][1], 0.0f);

        // বেলুনের সুতা (ঢেউ খেলানো রেখা)
        glColor3f(0.9f, 0.9f, 0.9f); // হালকা ধূসর সুতা
        glLineWidth(1.5f);
        glBegin(GL_LINE_STRIP);
        glVertex2f(0.0f, -0.04f);   // বেলুনের নিচের গাঁট
        glVertex2f(-0.01f, -0.08f); // বাঁকানো সুতা
        glVertex2f(0.01f, -0.12f);
        glVertex2f(0.0f, y - balloonPos[i][1] - 0.15f); // কাউন্টার পর্যন্ত
        glEnd();

        // বেলুনের মূল অংশ (উপবৃত্তাকার)
        glPushMatrix();
        glScalef(1.0f, 1.25f, 1.0f); // লম্বাটে আকৃতি
        // গাঢ় শেড (বাইরের স্তর)
        glColor3f(balloonColors[i][0]*0.7f, balloonColors[i][1]*0.7f, balloonColors[i][2]*0.7f);
        drawFilledCircle(0.0f, 0.0f, 0.035f);
        // উজ্জ্বল রঙ (ভেতরের হাইলাইট)
        glColor3f(balloonColors[i][0], balloonColors[i][1], balloonColors[i][2]);
        drawFilledCircle(-0.005f, 0.005f, 0.025f);
        glPopMatrix();

        // বেলুনের নিচের গাঁট (ছোট ত্রিভুজ)
        glColor3f(balloonColors[i][0]*0.7f, balloonColors[i][1]*0.7f, balloonColors[i][2]*0.7f);
        glBegin(GL_TRIANGLES);
        glVertex2f(0.0f, -0.04f);   // উপর বিন্দু
        glVertex2f(-0.01f, -0.055f); // নিচ-বাম
        glVertex2f(0.01f, -0.055f);  // নিচ-ডান
        glEnd();

        // বেলুনের আলোর প্রতিফলন
        glColor3f(1.0f, 1.0f, 1.0f);
        glPushMatrix();
        glScalef(1.0f, 2.0f, 1.0f);
        drawFilledCircle(-0.015f, 0.008f, 0.005f);
        glPopMatrix();

        glPopMatrix(); // বেলুনের matrix পুনরুদ্ধার
    }
    glLineWidth(1.0f);

    // ===== সাইড পোল (একটি উল্লম্ব রেখা) =====
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINES);
    glVertex2f(x + 0.12f, y - 0.30f); glVertex2f(x + 0.12f, y - 0.45f);
    glEnd();

    // ===== ডেকোরেটিভ চাকা =====
    float wx = x - 0.08f, wy = y - 0.35f, wr = 0.10f;
    glColor3f(0.0f, 0.0f, 0.0f);
    drawCircleOutline(wx, wy, wr); // চাকার বাইরের রিং
    glBegin(GL_LINES);
    // 45° পরপর ৮টি স্পোক (চাকার শলা)
    for (int i = 0; i < 360; i += 45) {
        float angle = i * PI / 180.0f;
        glVertex2f(wx, wy);                              // কেন্দ্র থেকে
        glVertex2f(wx + cos(angle) * wr, wy + sin(angle) * wr); // রিম পর্যন্ত
    }
    glEnd();

    // ===== দুটো খুঁটি =====
    glColor3f(0.55f, 0.35f, 0.15f); // বাদামি কাঠ
    glBegin(GL_QUADS);
    // বাম খুঁটি
    glVertex2f(x - 0.15f, y); glVertex2f(x - 0.13f, y);
    glVertex2f(x - 0.13f, y + 0.25f); glVertex2f(x - 0.15f, y + 0.25f);
    glEnd();
    glBegin(GL_QUADS);
    // ডান খুঁটি
    glVertex2f(x + 0.13f, y); glVertex2f(x + 0.15f, y);
    glVertex2f(x + 0.15f, y + 0.25f); glVertex2f(x + 0.13f, y + 0.25f);
    glEnd();

    // ===== নীল ছাউনি (আয়তাকার - ফলের দোকান থেকে আলাদা ডিজাইন) =====
    glColor3f(0.15f, 0.55f, 0.85f); // আকাশি নীল
    glBegin(GL_QUADS);
    glVertex2f(x - 0.20f, y + 0.25f); glVertex2f(x + 0.20f, y + 0.25f);
    glVertex2f(x + 0.20f, y + 0.38f); glVertex2f(x - 0.20f, y + 0.38f);
    glEnd();
    glColor3f(0.10f, 0.40f, 0.65f); // গাঢ় নীল বর্ডার
    glLineWidth(2.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(x - 0.20f, y + 0.25f); glVertex2f(x + 0.20f, y + 0.25f);
    glVertex2f(x + 0.20f, y + 0.38f); glVertex2f(x - 0.20f, y + 0.38f);
    glEnd();
    glLineWidth(1.0f);

    // ===== ছাউনির সাদা উল্লম্ব স্ট্রাইপ =====
    glColor3f(1.0f, 1.0f, 1.0f);
    glLineWidth(1.5f);
    for (float stripe = -0.16f; stripe <= 0.16f; stripe += 0.06f) {
        glBegin(GL_LINES);
        glVertex2f(x + stripe, y + 0.26f); // স্ট্রাইপের নিচ
        glVertex2f(x + stripe, y + 0.37f); // স্ট্রাইপের উপর (সোজা উল্লম্ব)
        glEnd();
    }
    glLineWidth(1.0f);
}


