/*
 * drawSky() - আকাশ আঁকে
 *
 * GL_QUADS দিয়ে চারটি কোণের বিন্দু দিয়ে একটি চতুর্ভুজ আঁকা হয়।
 * দিনে: গাঢ় নীল (উপরে) থেকে হালকা নীল (নিচে) - gradient effect
 * রাতে: গাঢ় কালো-নীল থেকে একটু হালকা নীল
 *
 * OpenGL এ প্রতিটি vertex এর আগে রঙ দিলে gradient (ধীরে রঙ পরিবর্তন) হয়
 */
void drawSky() {
    glBegin(GL_QUADS);
    if (isDayMode) {
        // দিনের আকাশ: উপরে গাঢ় নীল
        glColor3f(0.15f, 0.35f, 0.75f);
        glVertex2f(-1.0f, 1.0f);  // উপর-বাম কোণ
        glVertex2f( 1.0f, 1.0f);  // উপর-ডান কোণ
        // নিচে হালকা আকাশি নীল (gradient তৈরি হয়)
        glColor3f(0.55f, 0.78f, 0.95f);
        glVertex2f( 1.0f, LINE_TOP); // নিচ-ডান কোণ
        glVertex2f(-1.0f, LINE_TOP); // নিচ-বাম কোণ
    } else {
        // রাতের আকাশ: উপরে প্রায় কালো
        glColor3f(0.02f, 0.05f, 0.15f);
        glVertex2f(-1.0f, 1.0f);
        glVertex2f( 1.0f, 1.0f);
        // নিচে একটু হালকা নীল
        glColor3f(0.1f, 0.15f, 0.3f);
        glVertex2f( 1.0f, LINE_TOP);
        glVertex2f(-1.0f, LINE_TOP);
    }
    glEnd();
}


