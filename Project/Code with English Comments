/*
 * drawWheelLights() - Draws colored lights on the wheel's rim
 *
 * 16 lights are equally spaced on the wheel's rim.
 * wheelAngle is added so it rotates with the wheel.
 * 4 colors alternately (red, yellow, green, blue).
 *
 * radius = 0.38f -> Slightly smaller than wheel radius (stays on rim)
 */
void drawWheelLights() {
    float radius = 0.38f;
    int numLights = 16; // Total number of lights
    for (int i = 0; i < numLights; i++) {
        // Angle of each light = (i * 360/16 + wheelAngle) degrees
        float angle = (i * 360.0f / numLights + wheelAngle) * PI / 180.0f;
        float lx = cos(angle) * radius;
        float ly = sin(angle) * radius;

        // Color changes every 4 lights
        switch (i % 4) {
            case 0: glColor3f(1.0f, 0.2f, 0.2f); break; // Red
            case 1: glColor3f(1.0f, 1.0f, 0.2f); break; // Yellow
            case 2: glColor3f(0.2f, 1.0f, 0.2f); break; // Green
            case 3: glColor3f(0.2f, 0.5f, 1.0f); break; // Blue
        }
        drawFilledCircle(lx, ly, 0.015f); // Small filled circle = light
    }
}

/*
 * drawWheelRim() - Draws the outer ring of the wheel
 * Thick circular line of dark red color
 */
void drawWheelRim() {
    glColor3f(0.6f, 0.2f, 0.2f); // Dark red
    glLineWidth(3.0f);            // Thick line
    drawCircleOutline(0.0f, 0.0f, 0.37f); // Outer ring of wheel
    glLineWidth(1.0f);
}

/*
 * drawGondolaBox() - Draws a gondola (seat box) of the ferris wheel
 * Parameters:
 *   colorIndex : Which color gondola (0-3)
 *
 * Gondola parts:
 *   1. Black border box
 *   2. Colored bottom part (seat)
 *   3. Arch on top - hanging hook
 *   4. A passenger inside (drawn with drawHuman())
 *
 * 4 differently colored gondolas (red, green, blue, yellow)
 * 4 passengers with different shirt colors (white, yellow, orange, sky blue)
 */
void drawGondolaBox(int colorIndex) {
    // Gondola box colors
    float boxColors[4][3] = {
        {0.90f, 0.25f, 0.25f}, // Red
        {0.25f, 0.70f, 0.25f}, // Green
        {0.25f, 0.45f, 0.90f}, // Blue
        {0.90f, 0.70f, 0.15f}  // Yellow
    };
    // Passenger shirt colors
    float dressColors[4][3] = {
        {1.0f, 1.0f, 1.0f},   // White
        {1.0f, 1.0f, 0.0f},   // Yellow
        {1.0f, 0.6f, 0.2f},   // Orange
        {0.2f, 0.8f, 0.9f}    // Sky blue
    };

    int ci = colorIndex % 4; // Keeps it bounded between 0,1,2,3

    // Outer black border of gondola
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(-0.08f,  0.13f); // Top-left
    glVertex2f( 0.08f,  0.13f); // Top-right
    glVertex2f( 0.08f, -0.14f); // Bottom-right
    glVertex2f(-0.08f, -0.14f); // Bottom-left
    glEnd();

    // Colored seat part at the bottom of gondola
    glColor3f(boxColors[ci][0], boxColors[ci][1], boxColors[ci][2]);
    glBegin(GL_QUADS);
    glVertex2f(-0.08f, -0.07f); glVertex2f( 0.08f, -0.07f);
    glVertex2f( 0.08f, -0.14f); glVertex2f(-0.08f, -0.14f);
    glEnd();
    // Black border of seat
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(-0.08f, -0.07f); glVertex2f( 0.08f, -0.07f);
    glVertex2f( 0.08f, -0.14f); glVertex2f(-0.08f, -0.14f);
    glEnd();

    // Arch on top of gondola (hanging hook)
    glColor3f(0.0f, 0.0f, 0.0f);
    drawArch(0.0f, 0.13f, 0.08f, 0.06f);

    // Drawing passenger inside gondola
    drawHuman(0.0f, -0.07f, dressColors[ci][0], dressColors[ci][1], dressColors[ci][2]);
}

/*
 * drawFerrisWheel() - Draws the complete ferris wheel
 *
 * This function is called in a rotating state using glPushMatrix/glPopMatrix.
 * Meaning the whole wheel is rotating with wheelAngle.
 *
 * Parts:
 *   1. Outer ring (drawWheelRim)
 *   2. Two cross bars (horizontal and vertical)
 *   3. Colored lights (drawWheelLights)
 *   4. Golden bulb at center
 *   5. 4 gondolas (on 4 sides of wheel)
 *
 * Gondola specialty: Rotates with wheel but stays upright itself
 * (counter-rotation with glRotatef(-wheelAngle))
 */
void drawFerrisWheel() {
    drawWheelRim(); // Outer red ring

    // ===== Horizontal cross bar =====
    glColor3f(0.65f, 0.65f, 0.70f); // Gray metal
    glBegin(GL_QUADS);
    glVertex2f( 0.36f,  0.015f); glVertex2f( 0.36f, -0.015f);
    glVertex2f(-0.36f, -0.015f); glVertex2f(-0.36f,  0.015f);
    glEnd();
    glColor3f(0.3f, 0.3f, 0.35f);
    glBegin(GL_LINE_LOOP); // Border
    glVertex2f( 0.36f,  0.015f); glVertex2f( 0.36f, -0.015f);
    glVertex2f(-0.36f, -0.015f); glVertex2f(-0.36f,  0.015f);
    glEnd();

    // ===== Vertical cross bar =====
    glColor3f(0.65f, 0.65f, 0.70f);
    glBegin(GL_QUADS);
    glVertex2f( 0.015f,  0.36f); glVertex2f(-0.015f,  0.36f);
    glVertex2f(-0.015f, -0.36f); glVertex2f( 0.015f, -0.36f);
    glEnd();
    glColor3f(0.3f, 0.3f, 0.35f);
    glBegin(GL_LINE_LOOP);
    glVertex2f( 0.015f,  0.36f); glVertex2f(-0.015f,  0.36f);
    glVertex2f(-0.015f, -0.36f); glVertex2f( 0.015f, -0.36f);
    glEnd();

    drawWheelLights(); // Colored lights

    // ===== Golden bulb at center =====
    glColor3f(0.85f, 0.75f, 0.20f); // Golden
    drawFilledCircle(0.0f, 0.0f, 0.045f); // Large golden circle
    glColor3f(0.6f, 0.5f, 0.1f);
    drawCircleOutline(0.0f, 0.0f, 0.045f); // Border
    glColor3f(0.95f, 0.85f, 0.3f);
    drawFilledCircle(0.0f, 0.0f, 0.02f); // Small bright center

    // ===== 4 gondolas (on 4 sides of wheel) =====
    // Gondola positions: Right, Left, Top, Bottom
    float gondolaPos[4][2] = {
        { 0.36f,  0.00f}, // Right
        {-0.36f,  0.00f}, // Left
        { 0.00f,  0.36f}, // Top
        { 0.00f, -0.36f}  // Bottom
    };

    for (int i = 0; i < 4; i++) {
        glPushMatrix();
        glTranslatef(gondolaPos[i][0], gondolaPos[i][1], 0.0f); // Go to gondola position

        /*
         * counter-rotation: The wheel is rotating with wheelAngle,
         * The gondola is rotated inversely with -wheelAngle,
         * So the gondola always stays straight (upright) - just like a real ferris wheel!
         */
        glRotatef(-wheelAngle, 0, 0, 1);

        // Hanging wire (connection from wheel to gondola)
        glColor3f(0.3f, 0.3f, 0.3f);
        glLineWidth(2.0f);
        glBegin(GL_LINES);
        glVertex2f(0.0f,  0.00f); // Connection point with wheel
        glVertex2f(0.0f, -0.06f); // Top of gondola
        glEnd();
        glLineWidth(1.0f);

        glTranslatef(0.0f, -0.25f, 0.0f); // Move gondola down a bit
        drawGondolaBox(i); // Draw gondola
        glPopMatrix();
    }
}

/*
 * drawFerrisStand() - Draws the ferris wheel pole/stand
 *
 * Structure:
 *   1. Two diagonal legs (inverted V shape)
 *   2. A horizontal connecting bar in the middle
 *   3. A wide base plate at the bottom
 */
void drawFerrisStand() {
    float standTop    = WCY;        // Starts at the height of wheel center
    float standBottom = LINE_MIDDLE; // Ends at ground

    // ===== Two diagonal legs =====
    glColor3f(0.4f, 0.4f, 0.45f); // Gray metal
    glBegin(GL_QUADS);
    // Left leg (narrow at top, goes left getting wider at bottom)
    glVertex2f(WCX - 0.02f, standTop); glVertex2f(WCX + 0.01f, standTop);
    glVertex2f(WCX - 0.12f, standBottom); glVertex2f(WCX - 0.15f, standBottom);
    // Right leg
    glVertex2f(WCX - 0.01f, standTop); glVertex2f(WCX + 0.02f, standTop);
    glVertex2f(WCX + 0.15f, standBottom); glVertex2f(WCX + 0.12f, standBottom);
    glEnd();

    // Leg borders
    glColor3f(0.2f, 0.2f, 0.25f);
    glLineWidth(1.5f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(WCX - 0.02f, standTop); glVertex2f(WCX + 0.01f, standTop);
    glVertex2f(WCX - 0.12f, standBottom); glVertex2f(WCX - 0.15f, standBottom);
    glEnd();
    glBegin(GL_LINE_LOOP);
    glVertex2f(WCX - 0.01f, standTop); glVertex2f(WCX + 0.02f, standTop);
    glVertex2f(WCX + 0.15f, standBottom); glVertex2f(WCX + 0.12f, standBottom);
    glEnd();
    glLineWidth(1.0f);

    // ===== Middle horizontal connecting bar =====
    float midY = (standTop + standBottom) / 2.0f; // Mid-height between the two legs
    glColor3f(0.35f, 0.35f, 0.40f);
    glLineWidth(2.0f);
    glBegin(GL_LINES);
    glVertex2f(WCX - 0.08f, midY); // Left side
    glVertex2f(WCX + 0.08f, midY); // Right side
    glEnd();
    glLineWidth(1.0f);

    // ===== Bottom base plate =====
    glColor3f(0.3f, 0.3f, 0.35f);
    glBegin(GL_QUADS);
    glVertex2f(WCX - 0.18f, standBottom);          // Top-left
    glVertex2f(WCX + 0.18f, standBottom);          // Top-right
    glVertex2f(WCX + 0.18f, standBottom - 0.03f);  // Bottom-right
    glVertex2f(WCX - 0.18f, standBottom - 0.03f);  // Bottom-left
    glEnd();
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(WCX - 0.18f, standBottom); glVertex2f(WCX + 0.18f, standBottom);
    glVertex2f(WCX + 0.18f, standBottom - 0.03f); glVertex2f(WCX - 0.18f, standBottom - 0.03f);
    glEnd();
}


