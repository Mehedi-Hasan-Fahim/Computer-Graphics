//           CLOUD DRAWING (Cloud Drawing - Day and Night)
// ============================================================

/*
 * drawSingleCloud() - Draws a single cloud
 * Parameters:
 *   cx, cy : Cloud center position
 *   scale  : Cloud size multiplier (to make larger/smaller)
 *
 * Task: Creates a cotton-like cloud using 5 filled circles
 * Shows white clouds during day, gray clouds during night
 */
void drawSingleCloud(float cx, float cy, float scale) {
    // Determine cloud color based on day/night
    if (isDayMode) {
        glColor4f(1.0f, 1.0f, 1.0f, 1.0f); // White cloud, 100% opaque
    } else {
        glColor4f(0.35f, 0.35f, 0.45f, 0.9f); // Gray-blue cloud
    }
    // Large circle in the middle of the cloud
    drawFilledCircle(cx,              cy,             0.06f * scale);
    // Medium circles on left and right of cloud
    drawFilledCircle(cx - 0.05f*scale, cy - 0.01f*scale, 0.045f * scale);
    drawFilledCircle(cx + 0.05f*scale, cy - 0.01f*scale, 0.045f * scale);
    // Small circles on top of cloud (fluffy texture)
    drawFilledCircle(cx - 0.03f*scale, cy + 0.03f*scale, 0.04f * scale);
    drawFilledCircle(cx + 0.03f*scale, cy + 0.03f*scale, 0.04f * scale);
}

/*
 * drawClouds() - Draws all clouds and handles animation
 *
 * Clouds are moved from right to left by adding cloudOffset.
 * Wraps around when going off-screen (comes back from the right side)
 *
 * positions[][3] = {X position, Y position, size multiplier}
 */
void drawClouds() {
    float wrap = 2.4f; // How much to move before restarting

    // Initial positions and sizes of 5 clouds
    float positions[][3] = {
        {-0.7f, 0.85f, 1.0f},  // Cloud 1: Left side, normal size
        {-0.2f, 0.75f, 1.3f},  // Cloud 2: Mid-left, slightly larger
        { 0.3f, 0.90f, 0.9f},  // Cloud 3: Mid-right, slightly smaller
        { 0.7f, 0.78f, 1.1f},  // Cloud 4: Right, medium large
        { 0.0f, 0.95f, 0.8f}   // Cloud 5: Middle, small
    };

    for (int i = 0; i < 5; i++) {
        // Moving cloud by adding cloudOffset
        float x = positions[i][0] + cloudOffset;
        // If past right screen boundary, restart from left
        while (x > 1.3f)  x -= wrap;
        // If outside left screen boundary, restart from right
        while (x < -1.1f) x += wrap;
        drawSingleCloud(x, positions[i][1], positions[i][2]);
    }
}


// ============================================================
//          SUN / MOON DRAWING (Sun or Moon Drawing)
// ============================================================

/*
 * drawSunOrMoon() - Draws sun in day, moon in night
 *
 * Sun: Yellow circle + surrounding rays (thick lines using glLineWidth)
 *        Rays are drawn from 0° to 330° at 30° intervals
 *
 * Moon: White circle + small circles on top (to show craters)
 */
void drawSunOrMoon() {
    float sx = -0.8f, sy = 0.88f; // Sun/Moon position (top-left corner)

    if (isDayMode) {
        // ========== Drawing Sun ==========
        glColor3f(1.0f, 0.85f, 0.3f); // Golden yellow color
        glLineWidth(2.0f); // Thick line

        // Drawing sun rays (12 rays, 30° intervals)
        for (int i = 0; i < 360; i += 30) {
            float angle = i * PI / 180.0f;
            glBegin(GL_LINES);
            // Inner point of ray (on circle)
            glVertex2f(sx + cos(angle) * 0.07f, sy + sin(angle) * 0.07f);
            // Outer point of ray (outside circle)
            glVertex2f(sx + cos(angle) * 0.11f, sy + sin(angle) * 0.11f);
            glEnd();
        }
        glLineWidth(1.0f); // Back to normal line width

        // Yellow filled circle at sun's center
        glColor3f(1.0f, 0.92f, 0.2f);
        drawFilledCircle(sx, sy, 0.065f);
        // Dark yellow border of sun
        glColor3f(1.0f, 0.7f, 0.0f);
        drawCircleOutline(sx, sy, 0.065f);
    } else {
        // ========== Drawing Moon ==========
        // White-gray filled circle (full moon)
        glColor3f(0.9f, 0.9f, 0.95f);
        drawFilledCircle(sx, sy, 0.065f);

        // Drawing moon craters - 3 small gray circles
        glColor3f(0.75f, 0.75f, 0.8f);
        drawFilledCircle(sx - 0.015f, sy + 0.015f, 0.015f); // Large crater
        drawFilledCircle(sx + 0.020f, sy - 0.020f, 0.010f); // Medium crater
        drawFilledCircle(sx + 0.015f, sy + 0.025f, 0.008f); // Small crater
    }
}


