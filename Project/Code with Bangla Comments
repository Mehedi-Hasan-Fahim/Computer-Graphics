/*
 * drawNotification() - দোকানের কাছে গেলে কেনার বিজ্ঞপ্তি দেখায়
 *
 * আধা-স্বচ্ছ কালো বাক্সে "Buy Item? (Y/N)" লেখা দেখায়।
 * GL_BLEND দিয়ে transparency তৈরি করা হয়।
 * glutBitmapCharacter() দিয়ে প্রতিটি অক্ষর আঁকা হয়।
 */
void drawNotification() {
    // Transparency চালু
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);

    // ===== আধা-স্বচ্ছ কালো পটভূমি =====
    glColor4f(0.1f, 0.1f, 0.1f, 0.85f); // 85% অপ্যাক কালো
    glBegin(GL_QUADS);
    glVertex2f(-0.25f, 0.85f); glVertex2f( 0.25f, 0.85f);
    glVertex2f( 0.25f, 0.72f); glVertex2f(-0.25f, 0.72f);
    glEnd();

    // ===== সাদা বর্ডার =====
    glColor3f(1.0f, 1.0f, 1.0f);
    glLineWidth(2.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(-0.25f, 0.85f); glVertex2f( 0.25f, 0.85f);
    glVertex2f( 0.25f, 0.72f); glVertex2f(-0.25f, 0.72f);
    glEnd();
    glLineWidth(1.0f);

    // ===== হলুদ টেক্সট =====
    glColor3f(1.0f, 1.0f, 0.0f); // উজ্জ্বল হলুদ
    glRasterPos2f(-0.18f, 0.77f); // টেক্সটের শুরুর অবস্থান
    const char* msg = "Buy Item? (Y/N)";
    // প্রতিটি অক্ষর আলাদাভাবে আঁকা হচ্ছে
    for (const char* c = msg; *c != '\0'; c++) {
        glutBitmapCharacter(GLUT_BITMAP_HELVETICA_18, *c);
    }
    glDisable(GL_BLEND); // transparency বন্ধ
}


// ============================================================
//              MAIN DISPLAY FUNCTION (প্রধান প্রদর্শন ফাংশন)
// ============================================================

/*
 * display() - প্রতিটি ফ্রেমে সবকিছু আঁকে
 *
 * এটি OpenGL এর callback function - GLUT স্বয়ংক্রিয়ভাবে কল করে।
 * আঁকার ক্রম (Z-order) গুরুত্বপূর্ণ - পরে আঁকা জিনিস উপরে দেখায়।
 *
 * আঁকার ক্রম (পিছন থেকে সামনে):
 *   ১. আকাশ (সবচেয়ে পিছনে)
 *   ২. সূর্য/চাঁদ, তারা
 *   ৩. মেঘ
 *   ৪. গাছ
 *   ৫. মাটি, পথ, ঘাস
 *   ৬. রাতের অন্ধকার স্তর
 *   ৭. দোকান (বাম ও ডান)
 *   ৮. ফেরিস চাকা (স্ট্যান্ড + ঘূর্ণায়মান চাকা)
 *   ৯. ব্যবহারকারীর চরিত্র (সবচেয়ে সামনে)
 *   ১০. নোটিফিকেশন বাক্স (যদি দরকার হয়)
 *
 * Interaction Logic:
 *   - nearLeft/nearRight: চরিত্র দোকানের কাছে কিনা পরীক্ষা করে
 *   - askedLeft/askedRight: একবারের বেশি জিজ্ঞেস না করার জন্য
 */
void display() {
    glClear(GL_COLOR_BUFFER_BIT); // স্ক্রিন পরিষ্কার করো

    // ===== দোকানের কাছাকাছি কিনা পরীক্ষা =====
    // বাম দোকানের কাছে: X -0.95 থেকে -0.45 এবং Y -0.30 এর উপরে
    bool nearLeft  = (userX > -0.95f && userX < -0.45f && userY > -0.30f);
    // ডান দোকানের কাছে: X 0.45 থেকে 0.95 এবং Y -0.30 এর উপরে
    bool nearRight = (userX > 0.45f && userX < 0.95f && userY > -0.30f);

    // দোকানের কাছে গেলে এবং আগে জিজ্ঞেস না করলে নোটিফিকেশন দেখাও
    if (!askedLeft && nearLeft) {
        showNotification = true;
        currentShop = 1; // বাম দোকান
    } else if (!askedRight && nearRight) {
        showNotification = true;
        currentShop = 2; // ডান দোকান
    }

    // দোকান থেকে দূরে গেলে নোটিফিকেশন লুকাও
    if (!nearLeft && currentShop == 1)  showNotification = false;
    if (!nearRight && currentShop == 2) showNotification = false;

    // ===== দৃশ্যপট আঁকার ক্রম =====
    drawSky();          // ১. আকাশ (পটভূমি)
    drawSunOrMoon();    // ২. সূর্য বা চাঁদ
    drawStars();        // ৩. তারা (শুধু রাতে)
    drawClouds();       // ৪. মেঘ (অ্যানিমেটেড)
    drawTrees();        // ৫. গাছ
    drawGround();       // ৬. মাটির স্তর
    drawPathway();      // ৭. পথ
    drawGrassBlades();  // ৮. ঘাসের পাতা
    drawNightOverlay(); // ৯. রাতের অন্ধকার স্তর (রাতে)

    drawLeftStall();    // ১০. বাম ফলের দোকান
    drawRightStall();   // ১১. ডান বেলুনের দোকান

    drawFerrisStand();  // ১২. ফেরিস চাকার স্ট্যান্ড

    // ফেরিস চাকা ঘূর্ণায়মান অবস্থায় আঁকা
    glPushMatrix();                          // বর্তমান matrix সংরক্ষণ
    glTranslatef(WCX, WCY, 0.0f);           // চাকার কেন্দ্রে স্থানান্তর
    glRotatef(wheelAngle, 0, 0, 1);         // Z-অক্ষে wheelAngle দিয়ে ঘোরানো
    drawFerrisWheel();                       // চাকা আঁকা
    glPopMatrix();                           // matrix পুনরুদ্ধার

    drawUser(userX, userY); // ১৩. ব্যবহারকারীর চরিত্র (সবচেয়ে সামনে)

    // নোটিফিকেশন দেখানো (সবার উপরে)
    if (showNotification) drawNotification();

    glutSwapBuffers(); // Double buffering - ঝাঁকুনি ছাড়া মসৃণ অ্যানিমেশন
}


