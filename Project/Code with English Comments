/*
 * drawNotification() - Shows buy notification when near a shop
 *
 * Shows "Buy Item? (Y/N)" text in a semi-transparent black box.
 * Transparency is created using GL_BLEND.
 * Each character is drawn using glutBitmapCharacter().
 */
void drawNotification() {
    // Enable transparency
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);

    // ===== Semi-transparent black background =====
    glColor4f(0.1f, 0.1f, 0.1f, 0.85f); // 85% opaque black
    glBegin(GL_QUADS);
    glVertex2f(-0.25f, 0.85f); glVertex2f( 0.25f, 0.85f);
    glVertex2f( 0.25f, 0.72f); glVertex2f(-0.25f, 0.72f);
    glEnd();

    // ===== White border =====
    glColor3f(1.0f, 1.0f, 1.0f);
    glLineWidth(2.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(-0.25f, 0.85f); glVertex2f( 0.25f, 0.85f);
    glVertex2f( 0.25f, 0.72f); glVertex2f(-0.25f, 0.72f);
    glEnd();
    glLineWidth(1.0f);

    // ===== Yellow text =====
    glColor3f(1.0f, 1.0f, 0.0f); // Bright yellow
    glRasterPos2f(-0.18f, 0.77f); // Starting position of text
    const char* msg = "Buy Item? (Y/N)";
    // Drawing each character separately
    for (const char* c = msg; *c != '\0'; c++) {
        glutBitmapCharacter(GLUT_BITMAP_HELVETICA_18, *c);
    }
    glDisable(GL_BLEND); // Disable transparency
}


