// ============================================================

/*
 * display() - Draws everything on each frame
 *
 * This is OpenGL's callback function - GLUT calls it automatically.
 * Drawing order (Z-order) is important - things drawn later appear on top.
 *
 * Drawing order (back to front):
 *   1. Sky (furthest back)
 *   2. Sun/moon, stars
 *   3. Clouds
 *   4. Trees
 *   5. Ground, path, grass
 *   6. Night dark layer
 *   7. Shops (left and right)
 *   8. Ferris wheel (stand + rotating wheel)
 *   9. User character (furthest front)
 *   10. Notification box (if needed)
 *
 * Interaction Logic:
 *   - nearLeft/nearRight: Checks if character is near a shop
 *   - askedLeft/askedRight: To prevent asking more than once
 */
void display() {
    glClear(GL_COLOR_BUFFER_BIT); // Clear the screen

    // ===== Check if near a shop =====
    // Near left shop: X -0.95 to -0.45 and Y above -0.30
    bool nearLeft  = (userX > -0.95f && userX < -0.45f && userY > -0.30f);
    // Near right shop: X 0.45 to 0.95 and Y above -0.30
    bool nearRight = (userX > 0.45f && userX < 0.95f && userY > -0.30f);

    // Show notification if near shop and not asked before
    if (!askedLeft && nearLeft) {
        showNotification = true;
        currentShop = 1; // Left shop
    } else if (!askedRight && nearRight) {
        showNotification = true;
        currentShop = 2; // Right shop
    }

    // Hide notification if moved away from shop
    if (!nearLeft && currentShop == 1)  showNotification = false;
    if (!nearRight && currentShop == 2) showNotification = false;

    // ===== Scene drawing order =====
    drawSky();          // 1. Sky (background)
    drawSunOrMoon();    // 2. Sun or moon
    drawStars();        // 3. Stars (night only)
    drawClouds();       // 4. Clouds (animated)
    drawTrees();        // 5. Trees
    drawGround();       // 6. Ground layers
    drawPathway();      // 7. Path
    drawGrassBlades();  // 8. Grass blades
    drawNightOverlay(); // 9. Night dark layer (at night)

    drawLeftStall();    // 10. Left fruit shop
    drawRightStall();   // 11. Right balloon shop

    drawFerrisStand();  // 12. Ferris wheel stand

    // Drawing ferris wheel in rotating state
    glPushMatrix();                          // Save current matrix
    glTranslatef(WCX, WCY, 0.0f);           // Translate to wheel center
    glRotatef(wheelAngle, 0, 0, 1);         // Rotate by wheelAngle on Z-axis
    drawFerrisWheel();                       // Draw wheel
    glPopMatrix();                           // Restore matrix

    drawUser(userX, userY); // 13. User character (furthest front)

    // Show notification (on top of everything)
    if (showNotification) drawNotification();

    glutSwapBuffers(); // Double buffering - smooth animation without flickering
}


