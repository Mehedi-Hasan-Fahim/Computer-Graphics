/*
 * drawUser() - Draws the main player character
 * Parameters:
 *   cx, cy : Character's center position
 *
 * Character parts (bottom to top):
 *   1. Shoes (red quadrilateral)
 *   2. Pants (dark blue two legs)
 *   3. Shirt (yellow, orange button on chest)
 *   4. Hands (skin-colored thick lines + palm circles)
 *   5. Inventory item (balloon or fruit basket)
 *   6. Neck
 *   7. Head and hair
 *   8. Eyes and smile
 */
void drawUser(float cx, float cy) {

    // ===== Pants (two legs) =====
    glColor3f(0.15f, 0.25f, 0.45f); // Dark blue jeans color
    glBegin(GL_QUADS);
    // Left leg
    glVertex2f(cx - 0.05f, cy - 0.05f); glVertex2f(cx - 0.01f, cy - 0.05f);
    glVertex2f(cx - 0.01f, cy - 0.28f); glVertex2f(cx - 0.05f, cy - 0.28f);
    // Right leg
    glVertex2f(cx + 0.01f, cy - 0.05f); glVertex2f(cx + 0.05f, cy - 0.05f);
    glVertex2f(cx + 0.05f, cy - 0.28f); glVertex2f(cx + 0.01f, cy - 0.28f);
    glEnd();

    // ===== Shoes (red box under both legs) =====
    glColor3f(0.8f, 0.2f, 0.1f); // Red color
    glBegin(GL_QUADS);
    // Left shoe
    glVertex2f(cx - 0.06f, cy - 0.28f); glVertex2f(cx - 0.01f, cy - 0.28f);
    glVertex2f(cx - 0.01f, cy - 0.33f); glVertex2f(cx - 0.06f, cy - 0.33f);
    // Right shoe
    glVertex2f(cx + 0.01f, cy - 0.28f); glVertex2f(cx + 0.06f, cy - 0.28f);
    glVertex2f(cx + 0.06f, cy - 0.33f); glVertex2f(cx + 0.01f, cy - 0.33f);
    glEnd();

    // ===== Main part of shirt (yellow quadrilateral) =====
    glColor3f(0.95f, 0.75f, 0.15f); // Bright yellow
    glBegin(GL_QUADS);
    glVertex2f(cx - 0.07f, cy + 0.14f); // Top-left shoulder
    glVertex2f(cx + 0.07f, cy + 0.14f); // Top-right shoulder
    glVertex2f(cx + 0.08f, cy - 0.12f); // Bottom-right
    glVertex2f(cx - 0.08f, cy - 0.12f); // Bottom-left
    glEnd();

    // ===== Shirt button (orange design) =====
    glColor3f(0.85f, 0.45f, 0.10f); // Orange color
    glBegin(GL_QUADS);
    glVertex2f(cx - 0.02f, cy + 0.14f); glVertex2f(cx + 0.02f, cy + 0.14f);
    glVertex2f(cx + 0.02f, cy + 0.05f); glVertex2f(cx - 0.02f, cy + 0.05f);
    glEnd();

    // ===== Hands (drawn with thick lines) =====
    glColor3f(0.95f, 0.75f, 0.60f); // Skin color
    glLineWidth(6.0f); // Shows hands using thick lines
    glBegin(GL_LINES);
    // Left hand (hanging down)
    glVertex2f(cx - 0.07f, cy + 0.12f); glVertex2f(cx - 0.12f, cy - 0.02f);
    // Right hand (raised up - interactive pose)
    glVertex2f(cx + 0.07f, cy + 0.12f); glVertex2f(cx + 0.14f, cy + 0.18f);
    glEnd();
    // Hand palm (small filled circle)
    drawFilledCircle(cx - 0.12f, cy - 0.02f, 0.025f); // Left palm
    drawFilledCircle(cx + 0.14f, cy + 0.18f, 0.025f); // Right palm
    glLineWidth(1.0f);

    // ============================================================
    //       INVENTORY ITEMS (Showing bought items)
    // ============================================================

    /*
     * If hasRightItem = true, a balloon is shown in the right hand
     * Balloon: A string (LINE_STRIP) + elliptical circle + small triangle (bottom knot)
     */
  if (hasRightItem) {
        // Balloon string (wavy line)
        glColor3f(0.9f, 0.9f, 0.9f); // Light gray string
        glLineWidth(1.5f);
        glBegin(GL_LINE_STRIP);
        glVertex2f(cx + 0.15f, cy + 0.34f);  // Starts from balloon's bottom knot
        glVertex2f(cx + 0.13f, cy + 0.28f);  // Curved string (to the left)
        glVertex2f(cx + 0.16f, cy + 0.23f);  // Curved string (to the right)
        glVertex2f(cx + 0.14f, cy + 0.18f);  // Up to the palm of the hand
        glEnd();

        // Main part of balloon (ellipse - vertically elongated)
        glPushMatrix();
        glTranslatef(cx + 0.15f, cy + 0.38f, 0.0f);
        glScalef(1.0f, 1.25f, 1.0f); // Enlarge in Y direction to create ellipse
        glColor3f(0.1f * 0.7f, 0.7f * 0.7f, 1.0f * 0.7f); // Dark blue shade
        drawFilledCircle(0.0f, 0.0f, 0.035f);              // Outer circle
        glColor3f(0.1f, 0.7f, 1.0f);                       // Bright blue
        drawFilledCircle(-0.005f, 0.005f, 0.025f);          // Inner highlight
        glPopMatrix();

        // Balloon's bottom knot (small triangle)
        glColor3f(0.1f * 0.7f, 0.7f * 0.7f, 1.0f * 0.7f);
        glBegin(GL_TRIANGLES);
        glVertex2f(cx + 0.15f, cy + 0.34f);   // Top point
        glVertex2f(cx + 0.14f, cy + 0.325f);  // Bottom-left
        glVertex2f(cx + 0.16f, cy + 0.325f);  // Bottom-right
        glEnd();

        // Balloon's light reflection (small white circle)
        glColor3f(1.0f, 1.0f, 1.0f);
        glPushMatrix();
        glTranslatef(cx + 0.15f, cy + 0.38f, 0.0f);
        glScalef(1.0f, 2.0f, 1.0f);
        drawFilledCircle(-0.015f, 0.008f, 0.005f); // Small white dot
        glPopMatrix();
    }

    /*
     * If hasLeftItem = true, a fruit basket is shown in the left hand
     * Basket: Brown handle (LINE_STRIP) + brown box + an apple on top
     */
    if (hasLeftItem) {
        // Basket handle (U-shaped line)
        glColor3f(0.5f, 0.3f, 0.1f); // Brown
        glLineWidth(2.0f);
        glBegin(GL_LINE_STRIP);
        glVertex2f(cx - 0.14f, cy - 0.02f); // Top-left
        glVertex2f(cx - 0.14f, cy - 0.08f); // Bottom-left
        glVertex2f(cx - 0.10f, cy - 0.08f); // Bottom-right
        glVertex2f(cx - 0.10f, cy - 0.02f); // Top-right
        glEnd();
        glLineWidth(1.0f);

        // Main part of basket (trapezium shape - wide at top, narrow at bottom)
        glColor3f(0.85f, 0.65f, 0.35f); // Light brown
        glBegin(GL_QUADS);
        glVertex2f(cx - 0.16f, cy - 0.08f); // Top-left
        glVertex2f(cx - 0.08f, cy - 0.08f); // Top-right
        glVertex2f(cx - 0.09f, cy - 0.18f); // Bottom-right
        glVertex2f(cx - 0.15f, cy - 0.18f); // Bottom-left
        glEnd();

        // Top rim of basket (dark brown strip)
        glColor3f(0.65f, 0.45f, 0.20f);
        glBegin(GL_QUADS);
        glVertex2f(cx - 0.16f, cy - 0.08f); glVertex2f(cx - 0.08f, cy - 0.08f);
        glVertex2f(cx - 0.085f, cy - 0.10f); glVertex2f(cx - 0.155f, cy - 0.10f);
        glEnd();

        // Apple on top of basket
        glPushMatrix();
        glTranslatef(cx - 0.12f, cy - 0.06f, 0.0f);
        glColor3f(0.7f, 0.0f, 0.0f);           // Dark red apple
        drawFilledCircle(0.0f, 0.0f, 0.025f);
        glColor3f(1.0f, 0.2f, 0.2f);           // Bright red highlight
        drawFilledCircle(-0.006f, 0.006f, 0.012f);
        // Apple stem
        glColor3f(0.3f, 0.15f, 0.0f); glLineWidth(2.0f);
        glBegin(GL_LINES); glVertex2f(0.0f, 0.02f); glVertex2f(0.008f, 0.035f); glEnd();
        // Apple leaf
        glColor3f(0.1f, 0.6f, 0.1f);
        glBegin(GL_TRIANGLES);
        glVertex2f(0.008f, 0.025f); glVertex2f(0.025f, 0.035f); glVertex2f(0.018f, 0.012f);
        glEnd();
        glPopMatrix();
    }

    // ===== Neck =====
    glColor3f(0.95f, 0.75f, 0.60f); // Skin color
    glBegin(GL_QUADS);
    glVertex2f(cx - 0.02f, cy + 0.14f); glVertex2f(cx + 0.02f, cy + 0.14f);
    glVertex2f(cx + 0.02f, cy + 0.18f); glVertex2f(cx - 0.02f, cy + 0.18f);
    glEnd();

    // ===== Head (skin-colored circle) =====
    drawFilledCircle(cx, cy + 0.24f, 0.08f);

    // ===== Hair (black semicircle + small circles on sides) =====
    glColor3f(0.15f, 0.10f, 0.05f); // Black-brown
    glBegin(GL_POLYGON);
    // Coloring the top half of the head black
    for (int i = 0; i <= 180; i++) {
        float angle = i * PI / 180.0f;
        glVertex2f(cx + cos(angle) * 0.082f, cy + 0.26f + sin(angle) * 0.06f);
    }
    glEnd();
    // Messy hair part (large circle on side)
    drawFilledCircle(cx - 0.04f, cy + 0.28f, 0.025f);
    drawFilledCircle(cx + 0.02f, cy + 0.29f, 0.030f);
    drawFilledCircle(cx + 0.05f, cy + 0.27f, 0.020f);

    // ===== Eyes (white + black pupil + white shiny dot) =====
    glColor3f(1.0f, 1.0f, 1.0f);
    drawFilledCircle(cx - 0.03f, cy + 0.24f, 0.022f); // White part of left eye
    drawFilledCircle(cx + 0.03f, cy + 0.24f, 0.022f); // White part of right eye
    glColor3f(0.0f, 0.0f, 0.0f);
    drawFilledCircle(cx - 0.03f, cy + 0.24f, 0.015f); // Left pupil (black)
    drawFilledCircle(cx + 0.03f, cy + 0.24f, 0.015f); // Right pupil (black)
    glColor3f(1.0f, 1.0f, 1.0f);
    // Shiny highlight dot of the eye
    drawFilledCircle(cx - 0.035f, cy + 0.245f, 0.006f);
    drawFilledCircle(cx + 0.025f, cy + 0.245f, 0.006f);

    // ===== Smile (curved line) =====
    glColor3f(0.60f, 0.20f, 0.20f); // Dark red lip color
    glLineWidth(2.5f);
    glBegin(GL_LINE_STRIP);
    // Bottom part of circle from 210° to 330° - smile shape
    for (int i = 210; i <= 330; i++) {
        float angle = i * PI / 180.0f;
        glVertex2f(cx + cos(angle) * 0.025f, cy + 0.21f + sin(angle) * 0.025f);
    }
    glEnd();
    glLineWidth(1.0f);
}


// ============================================================
//       GENERIC HUMAN FIGURE (Generic Human - Shopkeeper and passengers)
// ============================================================

/*
 * drawHuman() - Draws a generic human character
 * Parameters:
 *   x, y    : Character's center position
 *   r, g, b : Shirt color (RGB values)
 *
 * Smaller and simpler design than drawUser().
 * Used for shopkeepers and ferris wheel passengers.
 * Different characters are created using the shirt color parameter.
 */
void drawHuman(float x, float y, float r, float g, float b) {

    // ===== Body (colored shirt - color taken from parameter) =====
    glColor3f(r, g, b); // Dynamic shirt color
    glBegin(GL_QUADS);
    // Body is slightly trapezium shaped (wide shoulders)
    glVertex2f(x - 0.035f, y + 0.08f); // Top-left (shoulder)
    glVertex2f(x + 0.035f, y + 0.08f); // Top-right (shoulder)
    glVertex2f(x + 0.04f,  y);          // Bottom-right (waist)
    glVertex2f(x - 0.04f,  y);          // Bottom-left (waist)
    glEnd();

    // Black border of shirt (outline)
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(x - 0.035f, y + 0.08f); glVertex2f(x + 0.035f, y + 0.08f);
    glVertex2f(x + 0.04f,  y); glVertex2f(x - 0.04f,  y);
    glEnd();

    // ===== Head (skin-colored circle + black border) =====
    glColor3f(0.90f, 0.72f, 0.50f); // Skin color
    drawFilledCircle(x, y + 0.12f, 0.04f);
    glColor3f(0.0f, 0.0f, 0.0f);
    drawCircleOutline(x, y + 0.12f, 0.04f);

    // ===== Hair (small version) =====
    glColor3f(0.15f, 0.10f, 0.05f);
    glBegin(GL_POLYGON);
    for (int i = 0; i <= 180; i++) {
        float angle = i * PI / 180.0f;
        glVertex2f(x + cos(angle) * 0.041f, y + 0.13f + sin(angle) * 0.03f);
    }
    glEnd();
    drawFilledCircle(x - 0.02f, y + 0.14f, 0.012f);
    drawFilledCircle(x + 0.01f, y + 0.145f, 0.015f);
    drawFilledCircle(x + 0.025f, y + 0.135f, 0.010f);

    // ===== Eyes (two black dots) =====
    glPointSize(2.5f);
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_POINTS);
    glVertex2f(x - 0.015f, y + 0.125f); // Left eye
    glVertex2f(x + 0.015f, y + 0.125f); // Right eye
    glEnd();

    // ===== Smile (small curved line) =====
    glBegin(GL_LINE_STRIP);
    for (int i = 210; i <= 330; i++) {
        float angle = i * PI / 180.0f;
        glVertex2f(x + cos(angle) * 0.02f, (y + 0.115f) + sin(angle) * 0.02f);
    }
    glEnd();

    // ===== Hands (two diagonal black lines) =====
    glColor3f(0.0f, 0.0f, 0.0f);
    glLineWidth(2.0f);
    glBegin(GL_LINES);
    // Left hand (pointing down)
    glVertex2f(x - 0.035f, y + 0.06f); glVertex2f(x - 0.07f, y + 0.03f);
    // Right hand (pointing down)
    glVertex2f(x + 0.035f, y + 0.06f); glVertex2f(x + 0.07f, y + 0.03f);
    glEnd();
    glLineWidth(1.0f);
}


// ============================================================
//           LEFT STALL - Fruit Shop (Left side)
// ============================================================

/*
 * drawLeftStall() - Draws the left side fruit shop
 *
 * Structure:
 *   1. Shopkeeper (pink shirt)
 *   2. Two vertical poles (brown quadrilateral)
 *   3. Red canopy (trapezium + white stripes)
 *   4. Counter (brown table)
 *   5. Fruits on counter (apple, orange, guava, lemon)
 *   6. Box/drawer at bottom
 */
void drawLeftStall() {
    float x = LSTALL_X, y = LSTALL_Y; // Center position of left shop

    // Drawing shopkeeper (wearing pink shirt)
    drawHuman(x, y + 0.0f, 0.8f, 0.3f, 0.6f);

    // ===== Two vertical wooden poles =====
    glColor3f(0.55f, 0.35f, 0.15f); // Brown wood color
    // Left pole
    glBegin(GL_QUADS);
    glVertex2f(x - 0.15f, y); glVertex2f(x - 0.13f, y);
    glVertex2f(x - 0.13f, y + 0.25f); glVertex2f(x - 0.15f, y + 0.25f);
    glEnd();
    // Right pole
    glBegin(GL_QUADS);
    glVertex2f(x + 0.13f, y); glVertex2f(x + 0.15f, y);
    glVertex2f(x + 0.15f, y + 0.25f); glVertex2f(x + 0.13f, y + 0.25f);
    glEnd();

    // ===== Red canopy (trapezoidal roof) =====
    glColor3f(0.85f, 0.15f, 0.15f); // Bright red
    glBegin(GL_QUADS);
    // Wide at bottom, narrow at top - canopy shape
    glVertex2f(x - 0.22f, y + 0.25f); // Bottom-left (wide)
    glVertex2f(x + 0.22f, y + 0.25f); // Bottom-right (wide)
    glVertex2f(x + 0.15f, y + 0.40f); // Top-right (narrow)
    glVertex2f(x - 0.15f, y + 0.40f); // Top-left (narrow)
    glEnd();
    // Black border of canopy
    glColor3f(0.65f, 0.10f, 0.10f);
    glLineWidth(2.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(x - 0.22f, y + 0.25f); glVertex2f(x + 0.22f, y + 0.25f);
    glVertex2f(x + 0.15f, y + 0.40f); glVertex2f(x - 0.15f, y + 0.40f);
    glEnd();
    glLineWidth(1.0f);

    // ===== White stripes of canopy =====
    glColor3f(1.0f, 1.0f, 1.0f);
    glLineWidth(1.5f);
    for (float stripe = -0.12f; stripe <= 0.12f; stripe += 0.06f) {
        glBegin(GL_LINES);
        glVertex2f(x + stripe, y + 0.26f);           // Bottom of stripe
        glVertex2f(x + stripe * 0.7f, y + 0.39f);    // Top of stripe (slightly tilted)
        glEnd();
    }
    glLineWidth(1.0f);

    // ===== Counter (sales table) =====
    glColor3f(0.90f, 0.78f, 0.55f); // Light brown wood
    glBegin(GL_QUADS);
    // Top board
    glVertex2f(x - 0.15f, y); glVertex2f(x + 0.15f, y);
    glVertex2f(x + 0.20f, y - 0.15f); glVertex2f(x - 0.20f, y - 0.15f);
    glEnd();
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINE_LOOP); // Counter border
    glVertex2f(x - 0.15f, y); glVertex2f(x + 0.15f, y);
    glVertex2f(x + 0.20f, y - 0.15f); glVertex2f(x - 0.20f, y - 0.15f);
    glEnd();

    // ===== Drawing fruits on counter =====
    // ---- Apple ----
    glPushMatrix(); // Save current matrix
    glTranslatef(x - 0.08f, y - 0.12f, 0.0f); // Move to apple's position
    glColor3f(0.7f, 0.0f, 0.0f); drawFilledCircle(0.0f, 0.0f, 0.03f); // Dark red
    glColor3f(1.0f, 0.2f, 0.2f); drawFilledCircle(-0.008f, 0.008f, 0.015f); // Highlight
    glColor3f(0.3f, 0.15f, 0.0f); glLineWidth(2.0f);
    glBegin(GL_LINES); glVertex2f(0.0f, 0.025f); glVertex2f(0.01f, 0.045f); glEnd(); // Stem
    glColor3f(0.1f, 0.6f, 0.1f);
    glBegin(GL_TRIANGLES); // Leaf
    glVertex2f(0.01f, 0.03f); glVertex2f(0.03f, 0.04f); glVertex2f(0.02f, 0.015f);
    glEnd();
    glPopMatrix(); // Restore matrix

    // ---- Orange ----
    glPushMatrix();
    glTranslatef(x - 0.02f, y - 0.12f, 0.0f);
    glColor3f(0.9f, 0.4f, 0.0f); drawFilledCircle(0.0f, 0.0f, 0.03f); // Orange color
    glColor3f(1.0f, 0.6f, 0.1f); drawFilledCircle(-0.005f, 0.005f, 0.02f); // Highlight
    glColor3f(0.1f, 0.4f, 0.1f); drawFilledCircle(0.0f, 0.025f, 0.005f); // Stem
    // Orange marks (texture points)
    glPointSize(1.5f); glColor3f(0.8f, 0.3f, 0.0f);
    glBegin(GL_POINTS);
    glVertex2f(0.01f, 0.01f); glVertex2f(-0.01f, -0.01f);
    glVertex2f(0.015f, -0.01f); glVertex2f(-0.005f, 0.015f);
    glEnd();
    glPopMatrix();

    // ---- Guava (green) ----
    glPushMatrix();
    glTranslatef(x + 0.04f, y - 0.12f, 0.0f);
    glColor3f(0.2f, 0.7f, 0.1f); drawFilledCircle(0.0f, 0.0f, 0.03f); // Green
    glColor3f(0.4f, 0.9f, 0.3f); drawFilledCircle(-0.008f, 0.008f, 0.015f); // Highlight
    glColor3f(0.3f, 0.15f, 0.0f); glLineWidth(2.0f);
    glBegin(GL_LINES); glVertex2f(0.0f, 0.025f); glVertex2f(-0.01f, 0.045f); glEnd(); // Stem
    glColor3f(0.1f, 0.5f, 0.1f);
    glBegin(GL_TRIANGLES); // Leaf
    glVertex2f(-0.01f, 0.03f); glVertex2f(-0.03f, 0.04f); glVertex2f(-0.02f, 0.015f);
    glEnd();
    glPopMatrix();

    // ---- Lemon (yellow ellipse) ----
    glPushMatrix();
    glTranslatef(x + 0.10f, y - 0.12f, 0.0f);
    glPushMatrix();
    glScalef(1.2f, 0.9f, 1.0f); // Larger in X, smaller in Y = elliptical lemon
    glColor3f(0.9f, 0.8f, 0.0f); drawFilledCircle(0.0f, 0.0f, 0.025f);
    glColor3f(1.0f, 1.0f, 0.4f); drawFilledCircle(-0.005f, 0.005f, 0.015f);
    glPopMatrix();
    // Small circles on both sides of lemon (lemon ends)
    glColor3f(0.9f, 0.8f, 0.0f);
    drawFilledCircle(-0.028f, 0.0f, 0.006f);
    drawFilledCircle(0.028f, 0.0f, 0.006f);
    glPopMatrix();
    glLineWidth(1.0f);

    // ===== Bottom storage box =====
    glColor3f(0.75f, 0.60f, 0.40f);
    glBegin(GL_QUADS);
    glVertex2f(x - 0.20f, y - 0.15f); glVertex2f(x + 0.20f, y - 0.15f);
    glVertex2f(x + 0.20f, y - 0.35f); glVertex2f(x - 0.20f, y - 0.35f);
    glEnd();
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(x - 0.20f, y - 0.15f); glVertex2f(x + 0.20f, y - 0.15f);
    glVertex2f(x + 0.20f, y - 0.35f); glVertex2f(x - 0.20f, y - 0.35f);
    glEnd();
}


// ============================================================
//          RIGHT STALL - Balloon Shop (Right side)
// ============================================================

/*
 * drawRightStall() - Draws the right side balloon shop
 *
 * Structure:
 *   1. Shopkeeper (green shirt)
 *   2. Counter box
 *   3. Three colored balloons (above counter)
 *   4. A wheel (side decoration)
 *   5. Two poles + blue canopy
 */
void drawRightStall() {
    float x = RSTALL_X, y = RSTALL_Y; // Center of right shop

    // Drawing shopkeeper (wearing green shirt)
    drawHuman(x, y + 0.0f, 0.2f, 0.8f, 0.4f);

    // ===== Counter box =====
    glColor3f(0.90f, 0.78f, 0.55f); // Brown wood
    glBegin(GL_QUADS);
    glVertex2f(x - 0.15f, y); glVertex2f(x + 0.15f, y);
    glVertex2f(x + 0.15f, y - 0.30f); glVertex2f(x - 0.15f, y - 0.30f);
    glEnd();
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINE_LOOP); // Border
    glVertex2f(x - 0.15f, y); glVertex2f(x + 0.15f, y);
    glVertex2f(x + 0.15f, y - 0.30f); glVertex2f(x - 0.15f, y - 0.30f);
    glEnd();

    // ===== Three colored balloons =====
    // Balloon colors (pink, blue, yellow)
    float balloonColors[3][3] = {
        {1.0f, 0.2f, 0.5f},  // Pink
        {0.1f, 0.7f, 1.0f},  // Sky blue
        {1.0f, 0.9f, 0.1f}   // Bright yellow
    };
    // Balloon positions (left, middle, right)
    float balloonPos[3][2] = {
        {x - 0.10f, y + 0.10f}, // Left balloon (slightly higher)
        {x + 0.00f, y + 0.03f}, // Middle balloon (slightly lower)
        {x + 0.10f, y + 0.10f}  // Right balloon (slightly higher)
    };

    for(int i = 0; i < 3; i++) {
        glPushMatrix();
        glTranslatef(balloonPos[i][0], balloonPos[i][1], 0.0f);

        // Balloon string (wavy line)
        glColor3f(0.9f, 0.9f, 0.9f); // Light gray string
        glLineWidth(1.5f);
        glBegin(GL_LINE_STRIP);
        glVertex2f(0.0f, -0.04f);   // Balloon's bottom knot
        glVertex2f(-0.01f, -0.08f); // Curved string
        glVertex2f(0.01f, -0.12f);
        glVertex2f(0.0f, y - balloonPos[i][1] - 0.15f); // Up to counter
        glEnd();

        // Main part of balloon (elliptical)
        glPushMatrix();
        glScalef(1.0f, 1.25f, 1.0f); // Elongated shape
        // Dark shade (outer layer)
        glColor3f(balloonColors[i][0]*0.7f, balloonColors[i][1]*0.7f, balloonColors[i][2]*0.7f);
        drawFilledCircle(0.0f, 0.0f, 0.035f);
        // Bright color (inner highlight)
        glColor3f(balloonColors[i][0], balloonColors[i][1], balloonColors[i][2]);
        drawFilledCircle(-0.005f, 0.005f, 0.025f);
        glPopMatrix();

        // Balloon's bottom knot (small triangle)
        glColor3f(balloonColors[i][0]*0.7f, balloonColors[i][1]*0.7f, balloonColors[i][2]*0.7f);
        glBegin(GL_TRIANGLES);
        glVertex2f(0.0f, -0.04f);   // Top point
        glVertex2f(-0.01f, -0.055f); // Bottom-left
        glVertex2f(0.01f, -0.055f);  // Bottom-right
        glEnd();

        // Balloon's light reflection
        glColor3f(1.0f, 1.0f, 1.0f);
        glPushMatrix();
        glScalef(1.0f, 2.0f, 1.0f);
        drawFilledCircle(-0.015f, 0.008f, 0.005f);
        glPopMatrix();

        glPopMatrix(); // Restore balloon matrix
    }
    glLineWidth(1.0f);

    // ===== Side pole (a vertical line) =====
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINES);
    glVertex2f(x + 0.12f, y - 0.30f); glVertex2f(x + 0.12f, y - 0.45f);
    glEnd();

    // ===== Decorative wheel =====
    float wx = x - 0.08f, wy = y - 0.35f, wr = 0.10f;
    glColor3f(0.0f, 0.0f, 0.0f);
    drawCircleOutline(wx, wy, wr); // Outer ring of wheel
    glBegin(GL_LINES);
    // 8 spokes at 45° intervals
    for (int i = 0; i < 360; i += 45) {
        float angle = i * PI / 180.0f;
        glVertex2f(wx, wy);                              // From center
        glVertex2f(wx + cos(angle) * wr, wy + sin(angle) * wr); // Up to rim
    }
    glEnd();

    // ===== Two poles =====
    glColor3f(0.55f, 0.35f, 0.15f); // Brown wood
    glBegin(GL_QUADS);
    // Left pole
    glVertex2f(x - 0.15f, y); glVertex2f(x - 0.13f, y);
    glVertex2f(x - 0.13f, y + 0.25f); glVertex2f(x - 0.15f, y + 0.25f);
    glEnd();
    glBegin(GL_QUADS);
    // Right pole
    glVertex2f(x + 0.13f, y); glVertex2f(x + 0.15f, y);
    glVertex2f(x + 0.15f, y + 0.25f); glVertex2f(x + 0.13f, y + 0.25f);
    glEnd();

    // ===== Blue canopy (rectangular - different design from fruit shop) =====
    glColor3f(0.15f, 0.55f, 0.85f); // Sky blue
    glBegin(GL_QUADS);
    glVertex2f(x - 0.20f, y + 0.25f); glVertex2f(x + 0.20f, y + 0.25f);
    glVertex2f(x + 0.20f, y + 0.38f); glVertex2f(x - 0.20f, y + 0.38f);
    glEnd();
    glColor3f(0.10f, 0.40f, 0.65f); // Dark blue border
    glLineWidth(2.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(x - 0.20f, y + 0.25f); glVertex2f(x + 0.20f, y + 0.25f);
    glVertex2f(x + 0.20f, y + 0.38f); glVertex2f(x - 0.20f, y + 0.38f);
    glEnd();
    glLineWidth(1.0f);

    // ===== White vertical stripes of canopy =====
    glColor3f(1.0f, 1.0f, 1.0f);
    glLineWidth(1.5f);
    for (float stripe = -0.16f; stripe <= 0.16f; stripe += 0.06f) {
        glBegin(GL_LINES);
        glVertex2f(x + stripe, y + 0.26f); // Bottom of stripe
        glVertex2f(x + stripe, y + 0.37f); // Top of stripe (straight vertical)
        glEnd();
    }
    glLineWidth(1.0f);
}


