/*
 * drawWheelLights() - চাকার রিমে রঙিন আলো আঁকে
 *
 * ১৬টি আলো সমান দূরত্বে চাকার রিমে অবস্থিত।
 * wheelAngle যোগ করা হয় তাই চাকার সাথে ঘোরে।
 * ৪টি রঙ পর্যায়ক্রমে (লাল, হলুদ, সবুজ, নীল)।
 *
 * radius = 0.38f → চাকার রেডিয়াস থেকে সামান্য ছোট (রিমে থাকে)
 */
void drawWheelLights() {
    float radius = 0.38f;
    int numLights = 16; // মোট আলোর সংখ্যা
    for (int i = 0; i < numLights; i++) {
        // প্রতিটি আলোর কোণ = (i * 360/16 + wheelAngle) ডিগ্রি
        float angle = (i * 360.0f / numLights + wheelAngle) * PI / 180.0f;
        float lx = cos(angle) * radius;
        float ly = sin(angle) * radius;

        // প্রতি ৪টি আলোয় রঙ পরিবর্তন হয়
        switch (i % 4) {
            case 0: glColor3f(1.0f, 0.2f, 0.2f); break; // লাল
            case 1: glColor3f(1.0f, 1.0f, 0.2f); break; // হলুদ
            case 2: glColor3f(0.2f, 1.0f, 0.2f); break; // সবুজ
            case 3: glColor3f(0.2f, 0.5f, 1.0f); break; // নীল
        }
        drawFilledCircle(lx, ly, 0.015f); // ছোট ভরা বৃত্ত = আলো
    }
}

/*
 * drawWheelRim() - চাকার বাইরের রিং আঁকে
 * গাঢ় লাল রঙের মোটা বৃত্তাকার রেখা
 */
void drawWheelRim() {
    glColor3f(0.6f, 0.2f, 0.2f); // গাঢ় লাল
    glLineWidth(3.0f);            // মোটা রেখা
    drawCircleOutline(0.0f, 0.0f, 0.37f); // চাকার বাইরের রিং
    glLineWidth(1.0f);
}

/*
 * drawGondolaBox() - ফেরিস চাকার একটি গন্ডোলা (আসন বাক্স) আঁকে
 * Parameters:
 *   colorIndex : কোন রঙের গন্ডোলা (0-3)
 *
 * গন্ডোলার অংশ:
 *   ১. কালো বর্ডার বাক্স
 *   ২. রঙিন নিচের অংশ (আসন)
 *   ৩. উপরে খিলান (arch) - ঝুলানোর হুক
 *   ৪. ভেতরে একজন যাত্রী (drawHuman() দিয়ে আঁকা)
 *
 * ৪টি ভিন্ন রঙের গন্ডোলা (লাল, সবুজ, নীল, হলুদ)
 * ৪জন যাত্রীর ভিন্ন জামার রঙ (সাদা, হলুদ, কমলা, আকাশি)
 */
void drawGondolaBox(int colorIndex) {
    // গন্ডোলার বাক্সের রঙ
    float boxColors[4][3] = {
        {0.90f, 0.25f, 0.25f}, // লাল
        {0.25f, 0.70f, 0.25f}, // সবুজ
        {0.25f, 0.45f, 0.90f}, // নীল
        {0.90f, 0.70f, 0.15f}  // হলুদ
    };
    // যাত্রীর জামার রঙ
    float dressColors[4][3] = {
        {1.0f, 1.0f, 1.0f},   // সাদা
        {1.0f, 1.0f, 0.0f},   // হলুদ
        {1.0f, 0.6f, 0.2f},   // কমলা
        {0.2f, 0.8f, 0.9f}    // আকাশি
    };

    int ci = colorIndex % 4; // 0,1,2,3 এর মধ্যে সীমাবদ্ধ রাখে

    // গন্ডোলার বাইরের কালো বর্ডার
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(-0.08f,  0.13f); // উপর-বাম
    glVertex2f( 0.08f,  0.13f); // উপর-ডান
    glVertex2f( 0.08f, -0.14f); // নিচ-ডান
    glVertex2f(-0.08f, -0.14f); // নিচ-বাম
    glEnd();

    // গন্ডোলার নিচের রঙিন আসন অংশ
    glColor3f(boxColors[ci][0], boxColors[ci][1], boxColors[ci][2]);
    glBegin(GL_QUADS);
    glVertex2f(-0.08f, -0.07f); glVertex2f( 0.08f, -0.07f);
    glVertex2f( 0.08f, -0.14f); glVertex2f(-0.08f, -0.14f);
    glEnd();
    // আসনের কালো বর্ডার
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(-0.08f, -0.07f); glVertex2f( 0.08f, -0.07f);
    glVertex2f( 0.08f, -0.14f); glVertex2f(-0.08f, -0.14f);
    glEnd();

    // গন্ডোলার উপরে খিলান (ঝুলানোর হুক)
    glColor3f(0.0f, 0.0f, 0.0f);
    drawArch(0.0f, 0.13f, 0.08f, 0.06f);

    // গন্ডোলার ভেতরে যাত্রী আঁকা
    drawHuman(0.0f, -0.07f, dressColors[ci][0], dressColors[ci][1], dressColors[ci][2]);
}

/*
 * drawFerrisWheel() - সম্পূর্ণ ফেরিস চাকা আঁকে
 *
 * এই ফাংশন glPushMatrix/glPopMatrix দিয়ে ঘূর্ণন অবস্থায় কল হয়।
 * অর্থাৎ পুরো চাকা wheelAngle দিয়ে ঘুরছে।
 *
 * অংশসমূহ:
 *   ১. বাইরের রিং (drawWheelRim)
 *   ২. দুটো ক্রস বার (অনুভূমিক ও উল্লম্ব)
 *   ৩. রঙিন আলো (drawWheelLights)
 *   ৪. কেন্দ্রের সোনালি বাল্ব
 *   ৫. ৪টি গন্ডোলা (চাকার ৪ দিকে)
 *
 * গন্ডোলার বিশেষত্ব: চাকার সাথে ঘোরে কিন্তু নিজে সোজা থাকে
 * (glRotatef(-wheelAngle) দিয়ে counter-rotation)
 */
void drawFerrisWheel() {
    drawWheelRim(); // বাইরের লাল রিং

    // ===== অনুভূমিক ক্রস বার =====
    glColor3f(0.65f, 0.65f, 0.70f); // ধূসর ধাতু
    glBegin(GL_QUADS);
    glVertex2f( 0.36f,  0.015f); glVertex2f( 0.36f, -0.015f);
    glVertex2f(-0.36f, -0.015f); glVertex2f(-0.36f,  0.015f);
    glEnd();
    glColor3f(0.3f, 0.3f, 0.35f);
    glBegin(GL_LINE_LOOP); // বর্ডার
    glVertex2f( 0.36f,  0.015f); glVertex2f( 0.36f, -0.015f);
    glVertex2f(-0.36f, -0.015f); glVertex2f(-0.36f,  0.015f);
    glEnd();

    // ===== উল্লম্ব ক্রস বার =====
    glColor3f(0.65f, 0.65f, 0.70f);
    glBegin(GL_QUADS);
    glVertex2f( 0.015f,  0.36f); glVertex2f(-0.015f,  0.36f);
    glVertex2f(-0.015f, -0.36f); glVertex2f( 0.015f, -0.36f);
    glEnd();
    glColor3f(0.3f, 0.3f, 0.35f);
    glBegin(GL_LINE_LOOP);
    glVertex2f( 0.015f,  0.36f); glVertex2f(-0.015f,  0.36f);
    glVertex2f(-0.015f, -0.36f); glVertex2f( 0.015f, -0.36f);
    glEnd();

    drawWheelLights(); // রঙিন আলো

    // ===== কেন্দ্রের সোনালি বাল্ব =====
    glColor3f(0.85f, 0.75f, 0.20f); // সোনালি
    drawFilledCircle(0.0f, 0.0f, 0.045f); // বড় সোনালি বৃত্ত
    glColor3f(0.6f, 0.5f, 0.1f);
    drawCircleOutline(0.0f, 0.0f, 0.045f); // বর্ডার
    glColor3f(0.95f, 0.85f, 0.3f);
    drawFilledCircle(0.0f, 0.0f, 0.02f); // ছোট উজ্জ্বল কেন্দ্র

    // ===== ৪টি গন্ডোলা (চাকার ৪ দিকে) =====
    // গন্ডোলার অবস্থান: ডান, বাম, উপর, নিচ
    float gondolaPos[4][2] = {
        { 0.36f,  0.00f}, // ডান
        {-0.36f,  0.00f}, // বাম
        { 0.00f,  0.36f}, // উপর
        { 0.00f, -0.36f}  // নিচ
    };

    for (int i = 0; i < 4; i++) {
        glPushMatrix();
        glTranslatef(gondolaPos[i][0], gondolaPos[i][1], 0.0f); // গন্ডোলার অবস্থানে যাও

        /*
         * counter-rotation: চাকা wheelAngle দিয়ে ঘুরছে,
         * গন্ডোলাকে -wheelAngle দিয়ে উল্টো ঘোরানো হচ্ছে,
         * ফলে গন্ডোলা সবসময় সোজা (সিধা) থাকে - বাস্তব ফেরিস চাকার মতো!
         */
        glRotatef(-wheelAngle, 0, 0, 1);

        // ঝুলানোর তার (গন্ডোলা থেকে চাকার সংযোগ)
        glColor3f(0.3f, 0.3f, 0.3f);
        glLineWidth(2.0f);
        glBegin(GL_LINES);
        glVertex2f(0.0f,  0.00f); // চাকার সাথে সংযোগ বিন্দু
        glVertex2f(0.0f, -0.06f); // গন্ডোলার উপরে
        glEnd();
        glLineWidth(1.0f);

        glTranslatef(0.0f, -0.25f, 0.0f); // গন্ডোলাকে একটু নিচে নামাও
        drawGondolaBox(i); // গন্ডোলা আঁকো
        glPopMatrix();
    }
}

/*
 * drawFerrisStand() - ফেরিস চাকার খুঁটি/স্ট্যান্ড আঁকে
 *
 * গঠন:
 *   ১. দুটো তির্যক পা (inverted V আকৃতি)
 *   ২. মাঝখানে একটি অনুভূমিক সংযোগ বার
 *   ৩. নিচে একটি চওড়া বেস প্লেট
 */
void drawFerrisStand() {
    float standTop    = WCY;        // চাকার কেন্দ্রের উচ্চতায় শুরু
    float standBottom = LINE_MIDDLE; // মাটিতে শেষ

    // ===== দুটো তির্যক পা =====
    glColor3f(0.4f, 0.4f, 0.45f); // ধূসর ধাতু
    glBegin(GL_QUADS);
    // বাম পা (উপরে চিকন, নিচে চওড়া হয়ে বামে যায়)
    glVertex2f(WCX - 0.02f, standTop); glVertex2f(WCX + 0.01f, standTop);
    glVertex2f(WCX - 0.12f, standBottom); glVertex2f(WCX - 0.15f, standBottom);
    // ডান পা
    glVertex2f(WCX - 0.01f, standTop); glVertex2f(WCX + 0.02f, standTop);
    glVertex2f(WCX + 0.15f, standBottom); glVertex2f(WCX + 0.12f, standBottom);
    glEnd();

    // পায়ের বর্ডার
    glColor3f(0.2f, 0.2f, 0.25f);
    glLineWidth(1.5f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(WCX - 0.02f, standTop); glVertex2f(WCX + 0.01f, standTop);
    glVertex2f(WCX - 0.12f, standBottom); glVertex2f(WCX - 0.15f, standBottom);
    glEnd();
    glBegin(GL_LINE_LOOP);
    glVertex2f(WCX - 0.01f, standTop); glVertex2f(WCX + 0.02f, standTop);
    glVertex2f(WCX + 0.15f, standBottom); glVertex2f(WCX + 0.12f, standBottom);
    glEnd();
    glLineWidth(1.0f);

    // ===== মাঝের অনুভূমিক সংযোগ বার =====
    float midY = (standTop + standBottom) / 2.0f; // দুই পায়ের মাঝামাঝি উচ্চতা
    glColor3f(0.35f, 0.35f, 0.40f);
    glLineWidth(2.0f);
    glBegin(GL_LINES);
    glVertex2f(WCX - 0.08f, midY); // বাম দিক
    glVertex2f(WCX + 0.08f, midY); // ডান দিক
    glEnd();
    glLineWidth(1.0f);

    // ===== নিচের বেস প্লেট =====
    glColor3f(0.3f, 0.3f, 0.35f);
    glBegin(GL_QUADS);
    glVertex2f(WCX - 0.18f, standBottom);          // উপর-বাম
    glVertex2f(WCX + 0.18f, standBottom);          // উপর-ডান
    glVertex2f(WCX + 0.18f, standBottom - 0.03f);  // নিচ-ডান
    glVertex2f(WCX - 0.18f, standBottom - 0.03f);  // নিচ-বাম
    glEnd();
    glColor3f(0.0f, 0.0f, 0.0f);
    glBegin(GL_LINE_LOOP);
    glVertex2f(WCX - 0.18f, standBottom); glVertex2f(WCX + 0.18f, standBottom);
    glVertex2f(WCX + 0.18f, standBottom - 0.03f); glVertex2f(WCX - 0.18f, standBottom - 0.03f);
    glEnd();
}


