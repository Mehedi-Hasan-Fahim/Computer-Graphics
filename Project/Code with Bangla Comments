/*
 * drawSingleCloud() - একটি মেঘ আঁকে
 * Parameters:
 *   cx, cy : মেঘের কেন্দ্র অবস্থান
 *   scale  : মেঘের আকার গুণক (বড়/ছোট করার জন্য)
 *
 * কাজ: ৫টি ভরা বৃত্ত দিয়ে একটি তুলোর মতো মেঘ তৈরি করা হয়
 * দিনে সাদা, রাতে ধূসর রঙের মেঘ দেখায়
 */
void drawSingleCloud(float cx, float cy, float scale) {
    // দিন/রাত অনুযায়ী মেঘের রঙ নির্ধারণ
    if (isDayMode) {
        glColor4f(1.0f, 1.0f, 1.0f, 1.0f); // সাদা মেঘ, 100% অপ্যাক
    } else {
        glColor4f(0.35f, 0.35f, 0.45f, 0.9f); // ধূসর-নীল মেঘ
    }
    // মেঘের মাঝখানে বড় বৃত্ত
    drawFilledCircle(cx,              cy,             0.06f * scale);
    // মেঘের বাম ও ডান দিকে মাঝারি বৃত্ত
    drawFilledCircle(cx - 0.05f*scale, cy - 0.01f*scale, 0.045f * scale);
    drawFilledCircle(cx + 0.05f*scale, cy - 0.01f*scale, 0.045f * scale);
    // মেঘের উপরে ছোট বৃত্ত (fluffy texture)
    drawFilledCircle(cx - 0.03f*scale, cy + 0.03f*scale, 0.04f * scale);
    drawFilledCircle(cx + 0.03f*scale, cy + 0.03f*scale, 0.04f * scale);
}

/*
 * drawClouds() - সব মেঘ আঁকে এবং অ্যানিমেশন পরিচালনা করে
 *
 * cloudOffset যোগ করে মেঘ ডান থেকে বামে সরানো হয়।
 * স্ক্রিনের বাইরে চলে গেলে wrap করে (আবার ডান দিক থেকে আসে)
 *
 * positions[][3] = {X অবস্থান, Y অবস্থান, আকার গুণক}
 */
void drawClouds() {
    float wrap = 2.4f; // কতটুকু সরলে পুনরায় শুরু হবে

    // ৫টি মেঘের প্রাথমিক অবস্থান ও আকার
    float positions[][3] = {
        {-0.7f, 0.85f, 1.0f},  // মেঘ ১: বাম দিকে, স্বাভাবিক আকার
        {-0.2f, 0.75f, 1.3f},  // মেঘ ২: মাঝ-বামে, একটু বড়
        { 0.3f, 0.90f, 0.9f},  // মেঘ ৩: মাঝ-ডানে, একটু ছোট
        { 0.7f, 0.78f, 1.1f},  // মেঘ ৪: ডানে, মাঝারি বড়
        { 0.0f, 0.95f, 0.8f}   // মেঘ ৫: মাঝখানে, ছোট
    };

    for (int i = 0; i < 5; i++) {
        // cloudOffset যোগ করে মেঘ সরানো হচ্ছে
        float x = positions[i][0] + cloudOffset;
        // স্ক্রিনের ডান সীমা পার হলে বাম দিক থেকে আবার শুরু
        while (x > 1.3f)  x -= wrap;
        // স্ক্রিনের বাম সীমার বাইরে গেলে ডান দিক থেকে শুরু
        while (x < -1.1f) x += wrap;
        drawSingleCloud(x, positions[i][1], positions[i][2]);
    }
}


